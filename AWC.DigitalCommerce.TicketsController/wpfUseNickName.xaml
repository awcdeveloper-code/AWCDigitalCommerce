<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfUseNickName"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="220" Width="540" Background="Cyan" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen" WindowState="Normal">
    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Content="IDENTIFICAR COMO:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                 Name="txtNickName"
                 FontSize="30"
                 MaxLength="25"
                 Background="White"
                 Foreground="DarkBlue"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Left"
                 FontWeight="DemiBold"
                 KeyUp="txtNickName_KeyUp"/>
            <Label Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Content="(MÁXIMO 25 CARACTERES)"
               FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="1"
                    Name="Cancel"
                    Click="btn_Cancel"
                    FontSize="15"
                    Width="110"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="5"
                    Click="btn_OK"
                    FontSize="15"
                    Width="110"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="ACEPTAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
