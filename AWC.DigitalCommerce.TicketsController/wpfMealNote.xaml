<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfMealNote"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="290" Width="700" Background="DarkBlue"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition />
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Image Source="Images/kitchen.ico"
                           Height="60"/>
                <Label Grid.Row="1" Grid.Column="1"
                       Name="MealDesc"
                       Foreground="Cyan"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Content="PRODUCTO"
                       FontSize="40"
                       FontWeight="DemiBold"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical">
                <Label Foreground="Cyan"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Content="Guarnición y/o Preparación Especial (Opcional)"
                       FontSize="25"
                       FontWeight="DemiBold"/>
                <TextBox Name="txtMealNote"
                         FontSize="30"
                         MaxLength="27"
                         VerticalAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontWeight="DemiBold"
                         PreviewTextInput="txtMealNote_PreviewTextInput"
                         KeyUp="txtMealNote_KeyUp"/>
            </StackPanel>
            <Button Grid.Row="3" Grid.Column="1"
                    Click="btn_OK"
                    Width="250"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/GreenCheck.png"
                               Width="25" Height="25" Margin="5"/>
                            <TextBlock Text="CONTINUAR"
                                       FontSize="30"
                                       VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
