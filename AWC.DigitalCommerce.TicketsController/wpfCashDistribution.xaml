<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfCashDistribution"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="665" Width="380" ResizeMode="NoResize"
        Background="Cyan"
        WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Border BorderBrush="DarkBlue" BorderThickness="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="DESGLOSE EFECTIVO"
                   FontSize="30"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="2" Grid.Column="1"
                   Name="lblWorkDay"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="100"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="3" Grid.Column="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="500"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="4" Grid.Column="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="1.000"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="5" Grid.Column="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="2.000"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="6" Grid.Column="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="5.000"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="7" Grid.Column="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="10.000"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="8" Grid.Column="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="20.000"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="9" Grid.Column="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Content="50.000"
                   FontSize="35"
                   FontWeight="DemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="2"
                     Name="txtBox_M100"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <TextBox Grid.Row="3" Grid.Column="2"
                     Name="txtBox_M500"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <TextBox Grid.Row="4" Grid.Column="2"
                     Name="txtBox_B1000"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <TextBox Grid.Row="5" Grid.Column="2"
                     Name="txtBox_B2000"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <TextBox Grid.Row="6" Grid.Column="2"
                     Name="txtBox_B5000"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <TextBox Grid.Row="7" Grid.Column="2"
                     Name="txtBox_B10000"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <TextBox Grid.Row="8" Grid.Column="2"
                     Name="txtBox_B20000"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <TextBox Grid.Row="9" Grid.Column="2"
                     Name="txtBox_B50000"
                     Background="White"
                     Margin="5"
                     FontSize="30"
                     Text="0"
                     HorizontalContentAlignment="Right"
                     PreviewTextInput="NumberValidationTextBox"
                     FontWeight="DemiBold"/>
            <Button Grid.Row="11" Grid.Column="1"
                    Name="btnCancel"
                    Click="btn_Cancel"
                    FontSize="25"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="11" Grid.Column="2"
                    Name="btnCalculate"
                    Click="btn_Calculate"
                    FontSize="25"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="OK" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
