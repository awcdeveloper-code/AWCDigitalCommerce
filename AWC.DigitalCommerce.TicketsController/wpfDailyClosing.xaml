<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfDailyClosing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="530" Width="620" Background="DarkBlue"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="FECHA CONTABLE:"
                   FontSize="50"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5"
                   Name="lblWorkDay"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="XX-XX-XXXX"
                   FontSize="60"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="FECHA ACTUAL:"
                   FontSize="50"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="5"
                   Name="lblToday"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="XX-XX-XXXX"
                   FontSize="60"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="7"
                    Foreground="Cyan"
                  VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="¿DESEA ACTUALIZAR LA FECHA CONTABLE?"
                   FontSize="28"
                   FontWeight="DemiBold"/>
            <Button Grid.Row="9" Grid.Column="3"
                    Name="btnYES"
                    Click="btn_YES"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/next.png"
                           Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="SI" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="9" Grid.Column="5"
                    Name="btnNO"
                    Click="btn_NO"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="NO" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
