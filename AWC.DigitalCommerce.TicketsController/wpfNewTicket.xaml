<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfNewTicket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" Background="DarkBlue"
        Height="745" Width="1220"
        WindowStyle="None" ResizeMode="NoResize">
    <Window.Resources>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="25"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="lBox_TablesSeats_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="25"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Cyan" BorderThickness="5">
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>
                <!--HEADER-->
                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9"
                       Name="lblWindowHeader"
                       Foreground="Cyan"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Content="SELECCIONE A SU CLIENTE"
                       FontSize="30"
                       FontWeight="DemiBold"/>
                <!-- VIP  -->
                <GroupBox Grid.Row="2" Grid.Column="1" Grid.RowSpan="5"
                          Name="VIPGroupBox"
                          Foreground="Cyan"
                          BorderBrush="Cyan"
                          BorderThickness="2"
                          Header="CLIENTES FRECUENTES"
                          FontSize="20"
                          FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <TextBox Name="txtSearchVIP"
                                 Background="Cyan"
                                 BorderBrush="DarkBlue"
                                 Width="328"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 FontSize="20"
                                 Margin="5"
                                 FontWeight="DemiBold"
                                 TextChanged="txtSearchVIP_TextChanged"
                                 GotFocus="txtSearchVIP_GotFocus" />
                        <ListBox Name="lBox_VIP"
                                 Height="165"
                                 Margin="5"
                                 BorderBrush="DarkBlue"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                                 SelectionChanged="lBox_VIP_SelectionChanged">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar">
                                    <Style.Triggers>
                                        <Trigger Property="Orientation" Value="Vertical">
                                            <Setter Property="Width" Value="40"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>
                        </ListBox>
                    </StackPanel>
                </GroupBox>
                <!-- Tables and Seats  -->
                <GroupBox Grid.Row="7" Grid.Column="1" Grid.RowSpan="4"
                          Name="TablesSeatsGroupBox"
                          Foreground="Cyan"
                          BorderBrush="Cyan"
                          BorderThickness="2"
                          Header="MESAS Y BARRAS"
                          FontSize="20"
                          FontWeight="DemiBold">
                <ListBox Name="lBox_TablesSeats"
                         ItemsSource="{Binding Tables[0]}"
                         ItemTemplate="{StaticResource lBox_TablesSeats_DataTemplate}"
                         Margin="5"
                         BorderBrush="DarkBlue"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         FontSize="20"
                         SelectionChanged="lBox_TablesSeats_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </GroupBox>
                <!-- New Table/Seat  -->
                <GroupBox Grid.Row="11" Grid.Column="1" Grid.RowSpan="3"
                          Name="NewTableGroupBox"
                          Foreground="Cyan"
                          BorderBrush="Cyan"
                          BorderThickness="2"
                          Header="AGREGAR"
                          FontSize="20"
                          FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <Label Foreground="Cyan"
                               VerticalAlignment="Center"
                               Content="CLIENTE FRECUENTE NUEVO:"
                               Margin="5,5,5,0"
                               FontSize="15"
                               FontWeight="DemiBold"/>
                        <TextBox Name="txtUnkowCust"
                                 BorderBrush="Cyan"
                                 Height="30"
                                 Margin="5,0,5,0"
                                 FontSize="20"
                                 FontWeight="DemiBold"
                                 GotFocus="txtUnkowCust_GotFocus"
                                 KeyUp="txtUnkowCust_KeyUp"/>
                        <Label Foreground="Cyan"
                               VerticalAlignment="Center"
                               Content="MESA/BARRA TEMPORAL:"
                               Margin="5,5,5,0"
                               FontSize="15"
                               FontWeight="DemiBold"/>
                        <TextBox Name="txtNewTableSeat"
                                 BorderBrush="Cyan"
                                 Height="30"
                                 Margin="5,0,5,0"
                                 FontSize="20"
                                 FontWeight="DemiBold"
                                 GotFocus="txtNewTableSeat_GotFocus"
                                 KeyUp="txtNewTableSeat_KeyUp"/>
                        <CheckBox Name="ApplyServiceFee"
                                  VerticalAlignment="Top"
                                  Foreground="Cyan"
                                  IsChecked="False"
                                  Margin="5"
                                  FontSize="15"
                                  FontWeight="DemiBold"
                                  Content=" APLICAR 10% DE SERVICIO"/>
                    </StackPanel>
                </GroupBox>
                <!--LABEL COLUMN-->
                <StackPanel Grid.Row="2" Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Image Source="Images/beer.png"
                           Height="40"/>
                    <Label Name="lblBeerSoda"
                           Foreground="Cyan"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Content="BEBIDAS"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Image Source="Images/liquors.ico"
                           Height="40"/>
                    <Label Name="lblLiqour"
                           Foreground="Cyan"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Content="LICORES"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="10" Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Image Source="Images/kitchen.ico"
                           Height="40"/>
                    <Label Name="lblMeal"
                           Foreground="Cyan"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Content="COMIDAS"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                </StackPanel>
                <!--LISTBOX COLUMN-->
                <StackPanel Grid.Row="2" Grid.Column="5" Grid.RowSpan="4"
                            Orientation="Vertical">
                    <TextBox Name="txtSearchBeer"
                             Background="Cyan"
                             BorderBrush="DarkBlue"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             FontSize="20"
                             Margin="5"
                             FontWeight="DemiBold"
                             TextChanged="txtSearchBeer_TextChanged" GotFocus="txtSearchBeer_GotFocus" />
                    <ListBox Name="lBox_Beer"
                             ItemTemplate="{StaticResource Items_DataTemplate}"
                             Height="150"
                             Margin="5,0,5,5"
                             BorderBrush="DarkBlue"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             FontSize="20"
                             SelectionMode="Single"
                             SelectionChanged="lBox_Beer_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="5" Grid.RowSpan="4"
                            Orientation="Vertical">
                    <TextBox Name="txtSearchLiqour"
                             Background="Cyan"
                             BorderBrush="DarkBlue"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             FontSize="20"
                             Margin="5"
                             FontWeight="DemiBold"
                             TextChanged="txtSearchLiqour_TextChanged"
                             GotFocus="txtSearchLiqour_GotFocus" />
                    <ListBox Name="lBox_Liqour"
                             ItemTemplate="{StaticResource Items_DataTemplate}"
                             Height="150"
                             Margin="5,0,5,5"
                             BorderBrush="DarkBlue"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             FontSize="20"
                             SelectionMode="Single"
                             SelectionChanged="lBox_Liqour_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Row="10" Grid.Column="5" Grid.RowSpan="3"
                            Orientation="Vertical">
                    <TextBox Name="txtSearchMeal"
                             Background="Cyan"
                             BorderBrush="DarkBlue"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             FontSize="20"
                             Margin="5"
                             FontWeight="DemiBold"
                             TextChanged="txtSearchMeal_TextChanged"
                             GotFocus="txtSearchMeal_GotFocus" />
                    <ListBox Name="lBox_Meal"
                             ItemsSource="{Binding Tables[0]}"
                             ItemTemplate="{StaticResource Items_DataTemplate}"
                             Height="100"
                             Margin="5,0,5,5"
                             BorderBrush="DarkBlue"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             FontSize="20"
                             SelectionMode="Single"
                             SelectionChanged="lBox_Meal_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>

                    </ListBox>
                </StackPanel>
                <!--TEXTBOX COLUMN-->
                <TextBox Grid.Row="2" Grid.Column="7"
                         Name="txtQtyBeer"
                         PreviewTextInput="NumberValidationTextBox"
                         Width="50"
                         FontSize="25"
                         Background="Cyan"
                         BorderBrush="DarkBlue"
                         Foreground="DarkBlue"
                         VerticalAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontWeight="DemiBold"
                         GotFocus="txtQtyBeer_GotFocus"/>
                <TextBox Grid.Row="6" Grid.Column="7"
                         Name="txtQtyLiqour"
                         PreviewTextInput="NumberValidationTextBox"
                         Width="50"
                         FontSize="25"
                         Background="Cyan"
                         BorderBrush="DarkBlue"
                         Foreground="DarkBlue"
                         VerticalAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontWeight="DemiBold" GotFocus="txtQtyLiqour_GotFocus"/>
                <TextBox Grid.Row="10" Grid.Column="7"
                         Name="txtQtyMeal"
                         PreviewTextInput="NumberValidationTextBox"
                         Width="50"
                         FontSize="25"
                         Background="Cyan"
                         BorderBrush="DarkBlue"
                         Foreground="DarkBlue"
                         VerticalAlignment="Center"
                         HorizontalContentAlignment="Center"
                         FontWeight="DemiBold" GotFocus="txtQtyMeal_GotFocus"/>
                <!--ADD COLUMN-->
                <Button Grid.Row="2" Grid.Column="8"
                        Name="AddBeer"
                        Click="btn_AddBeer"
                        Foreground="DarkBlue"
                        VerticalAlignment="Center"
                        Height="50"
                        FontSize="20"
                        Padding="3"
                        Cursor="Hand"
                        FontWeight="DemiBold"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Plus_sign.png" Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="AGREGAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="6" Grid.Column="8"
                        Name="AddLiqour"
                        Click="btn_AddLiqour"
                        Foreground="DarkBlue"
                        VerticalAlignment="Center"
                        Height="50"
                        FontSize="20"
                        Padding="3"
                        Cursor="Hand"
                        FontWeight="DemiBold"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Plus_sign.png" Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="AGREGAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="10" Grid.Column="8"
                        Name="AddMeal"
                        Click="btn_AddMeal"
                        Foreground="DarkBlue"
                        VerticalAlignment="Center"
                        Height="50"
                        FontSize="20"
                        Padding="3"
                        Cursor="Hand"
                        FontWeight="DemiBold"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Plus_sign.png" Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="AGREGAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!--CANCEL ORDER-->
                <StackPanel Grid.Row="13" Grid.Column="3"
                            Orientation="Vertical"
                            VerticalAlignment="Center">
                    <Button Name="Clean"
                            Click="btn_CleanOrder"
                            Foreground="DarkBlue"
                            FontSize="20"
                            Margin="2"
                            Height="50"
                            Cursor="Hand"
                            FontWeight="DemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/CLEAN.PNG" Width="30" Height="30" Margin="5 5 5 0"/>
                            <TextBlock Text="BORRAR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="Close"
                            Click="btn_Close"
                            FontSize="20"
                            Margin="2"
                            Height="50"
                            Cursor="Hand"
                            FontWeight="DemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/delete_sign.png" Width="30" Height="30" Margin="5"/>
                            <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!--TAKE ORDER-->
                <Button Grid.Row="13" Grid.Column="5"
                        Name="TakeOrder"
                        Click="btn_TakeOrder"
                        IsEnabled="False"
                        FontSize="30"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <Image Source="/Images/GreenCheck.png"
                               Width="50" Height="50"/>
                        <TextBlock Text="CONFIRMAR ORDEN" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!--USUALLY & PRINT ORDER-->
                <StackPanel Grid.Row="13" Grid.Column="7" Grid.ColumnSpan="2"
                            Orientation="Vertical">
                    <Button Name="FreqItems"
                            Click="btn_FreqItems"
                            IsEnabled="False"
                            FontSize="20"
                            Margin="2"
                            Height="50"
                            Cursor="Hand"
                            FontWeight="DemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/Usually.png" Width="30" Height="30"
                               Margin="5"/>
                            <TextBlock Text="USUALMENTE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox Name="PrintOrder"
                              Click="chkBox_PrintOrder"
                              VerticalAlignment="Center"
                              Foreground="Cyan"
                              IsChecked="False"
                              Margin="2,15,0,0"
                              FontSize="15"
                              FontWeight="DemiBold"
                              Content="IMPRIMIR ORDEN"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
