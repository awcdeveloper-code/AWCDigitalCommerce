<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSpecialItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="210" Width="450" Background="DarkBlue" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Window.Resources>
        <DataTemplate x:Key="cBox_SpecialItems_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1"
               Name="lblPayMethodSelection"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Foreground="Cyan"
               FontSize="25"
               FontWeight="Bold"
               Content="SELECCIONE CONCEPTO"/>
            <ComboBox Grid.Row="3" Grid.Column="1"
                  Name="cbox_SpecialItems"
                  VerticalAlignment="Center"
                  FontSize="25"
                  FontWeight="DemiBold"
                  ItemTemplate="{StaticResource cBox_SpecialItems_DataTemplate}"/>
            <StackPanel Grid.Row="5" Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                <Button Click="btn_Cancel"
                    Foreground="DarkBlue"
                    Width="200"
                    FontSize="25"
                    Margin="5"
                    Padding="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/delete_sign.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="CANCELAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="btn_OK"
                    Foreground="DarkBlue"
                    Width="200"
                    FontSize="25"
                    Margin="5"
                    Padding="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/13.ico" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="ACEPTAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
