<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfCustomerList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="605" Width="410" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="Cyan">
    <Window.Resources>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="470"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="30"
               Margin="5"
               FontWeight="DemiBold"
               Content="SELECCIONAR CLIENTE"/>
        <ListBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                 Name="lBox_CustomerID"
                 Margin="5"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 FontSize="20"
                 SelectionMode="Single"
                 ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                 SelectionChanged="lBox_CustomerID_SelectionChanged" />
        <Button Grid.Row="3" Grid.Column="1"
                Click="btn_Cancel"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="CANCELAR"/>
        <Button Grid.Row="3" Grid.Column="2"
                Name="Reassign"
                Click="btn_Assign"
                FontSize="20"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="REASIGNAR"/>
    </Grid>
</Window>
