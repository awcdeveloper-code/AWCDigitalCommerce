<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSplitTicket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="550" Width="830" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Cyan">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="lBox_Customer_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Red" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--HEADER-->
            <Label Grid.Row="1" Grid.Column="1"
                   Content="CUENTA:"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="2"
                   Name="lblTicketNumber"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                   Name="lblCustomerName"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <!--SOURCE DATAGRID-->
            <DataGrid Grid.Row="2" Grid.Column="1"
                      Grid.ColumnSpan="8"
                      Grid.RowSpan="5"
                      Name="TicketDetailSource"
                      Height="190" Width="790"
                      RowHeight="30"
                      FontSize="20"
                      FontWeight="DemiBold"
                      Margin="5"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Hidden"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="White"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="DarkBlue" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      FrozenColumnCount="2"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False"
                      SelectionChanged="TicketDetailSource_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                    Width="75"
                                    Binding="{Binding Path=ItemID}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                    Width="360"
                                    Binding="{Binding Path=ItemDesc}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="CANT"
                                    Width="85"
                                    Binding="{Binding Path=Qty}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PRECIO"
                                    Width="115"
                                    Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TOTAL"
                                    Width="125"
                                    Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!--BUTTONS-->
            <Button Grid.Row="7" Grid.Column="1"
                Name="Close"
                Click="btn_Close"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="CERRAR"/>
            <Button Grid.Row="7" Grid.Column="2"
                    Name="Cancel"
                    Click="btn_Cancel"
                    FontSize="15"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold"
                    Content="CANCEL"/>
            <Image Grid.Row="7" Grid.Column="4"
                   Name="AddOne2Bottom"
                   Source="/Images/arrow_down_icon.png"
                   Margin="5"
                   ToolTip="Asignar el item seleccionado."
                   Cursor="Hand"
                   Visibility="Hidden"
                   MouseDown="btn_Add2Bottom"/>
            <Image Grid.Row="7" Grid.Column="5"
                   Name="AddOne2Top"
                   Source="/Images/arrow_up_icon.png"
                   Margin="5"
                   ToolTip="Devolver el item seleccionado."
                   Cursor="Hand"
                   Visibility="Hidden"
                   MouseDown="btn_Add2Top"/>
            <Button Grid.Row="7" Grid.Column="7"
                    Name="Print"
                    Click="btn_Print"
                    FontSize="15"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold"
                    Content="IMPRIMIR"/>
            <Button Grid.Row="7" Grid.Column="8"
                    Name="Pay"
                    Click="btn_Pay"
                    FontSize="15"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold"
                    Content="PAGAR"/>
            <!--=TARGET DATAGRID-->
            <DataGrid Grid.Row="8" Grid.Column="1"
                      Grid.ColumnSpan="8"
                      Grid.RowSpan="5"
                      Name="TicketDetailTarget"
                      Height="185" Width="790"
                      RowHeight="30"
                      FontSize="20"
                      FontWeight="DemiBold"
                      Margin="5"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Hidden"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="White"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="DarkBlue" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      FrozenColumnCount="2"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False"
                      SelectionChanged="TicketDetailTarget_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                    Width="75"
                                    Binding="{Binding Path=ItemID}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                    Width="360"
                                    Binding="{Binding Path=ItemDesc}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="CANT"
                                    Width="85"
                                    Binding="{Binding Path=Qty}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PRECIO"
                                    Width="115"
                                    Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TOTAL"
                                    Width="125"
                                    Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Label Grid.Row="13" Grid.Column="4" Grid.ColumnSpan="2"
               Foreground="DarkBlue"
               Content="10% SERVICIO:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="20"
               FontWeight="DemiBold"/>
            <Label Grid.Row="13" Grid.Column="6"
               Name="lblServiceFee"
               Foreground="DarkBlue"
               Content="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="20"
               FontWeight="DemiBold"/>
            <Label Grid.Row="13" Grid.Column="7"
               Foreground="DarkBlue"
               Content="TOTAL:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="20"
               FontWeight="DemiBold"/>
            <Label Grid.Row="13" Grid.Column="8"
               Name="lblTotalPrice"
               Foreground="DarkBlue"
               Content="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="20"
               FontWeight="DemiBold"/>
        </Grid>
    </Border>
</Window>
