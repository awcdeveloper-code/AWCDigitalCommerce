<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfTicketsInherited"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Background="Cyan" Height="570" Width="1100"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="lBox_Ticket_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Red" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="370"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--DATE RANGE-->
            <Label Grid.Row="1" Grid.Column="1"
               Foreground="DarkBlue"
               Content="FECHA INICIAL:"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="DemiBold"/>
            <DatePicker Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                    Name="StartDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="StartDate_SelectedDateChanged"/>
            <Label Grid.Row="2" Grid.Column="1"
               Foreground="DarkBlue"
               Content="FECHA FINAL:"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="DemiBold"/>
            <DatePicker Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                    Name="FinishDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="FinishDate_SelectedDateChanged"/>
            <Label Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="6"
                   Foreground="DarkBlue"
                   Content="RESUMEN CUENTAS HEREDADAS"
                   VerticalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <!--TICKET-->
            <DataGrid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="6"
                  Name="TicketsList"
                  Height="355" Width="750"
                  Margin="5"
                  RowHeight="25"
                  FontSize="18"
                  FontWeight="DemiBold"
                  IsReadOnly="True"
                  HorizontalAlignment="Left"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible" 
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="LightGray"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  BorderBrush="DarkBlue" BorderThickness="2"
                  AreRowDetailsFrozen="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False"
                  SelectionChanged="TicketsList_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA"
                                    Width="115"
                                    Binding="{Binding Path=TicketDate}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CUENTA"
                                    Width="90"
                                    Binding="{Binding Path=TicketID}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CLIENTE ORIGINAL"
                                    Width="260"
                                    Binding="{Binding Path=FromCustomer}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="CLIENTE DESTINO"
                                    Width="260"
                                    Binding="{Binding Path=ToCustomer}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <!--TICKET DETAIL DATAGRID-->
            <DataGrid Grid.Row="3" Grid.Column="7" Grid.ColumnSpan="3"
                  Name="TicketDetails"
                  Height="355" Width="290"
                  Margin="5"
                  RowHeight="25"
                  FontSize="18"
                  FontWeight="DemiBold"
                  IsReadOnly="True"
                  HorizontalAlignment="Left"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible" 
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="LightGray"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  BorderBrush="DarkBlue" BorderThickness="2"
                  AreRowDetailsFrozen="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CANT"
                                    Width="60"
                                    Binding="{Binding Path=Qty}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCION"
                                    Width="230"
                                    Binding="{Binding Path=ItemDesc}"/>
                </DataGrid.Columns>
            </DataGrid>
            <!--TEXBOX ABORT REASON-->
            <!--BUTTONS-->
            <Label Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="7"
               Name="AbortReason"
               VerticalAlignment="Center"
               Content="USUARIO:"
               FontSize="15"
               FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="1"
                Click="btn_Close"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
