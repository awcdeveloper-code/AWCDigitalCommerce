<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfQryTicketByNumber"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="660" Width="770" Background="Cyan"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Red" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*" />
                <RowDefinition Height="50"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1"
               VerticalAlignment="Center"
               Content="CUENTA:"
               FontSize="20"
               FontWeight="DemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="2"
                 Name="txtSearchTicket"
                 PreviewTextInput="NumberValidationTextBox"
                 Width="80"
                 Background="LightCyan"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 FontSize="20"
                 Margin="5"
                 FontWeight="DemiBold"
                 KeyUp="txtSearchTicket_KeyUp" />
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                <Label Content="CLIENTE:"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
                <Label Name="CustomerID"
                   VerticalAlignment="Center"
                   Width="280"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            </StackPanel>
            <Label Grid.Row="3" Grid.Column="1"
               Content="TOTAL:"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               FontSize="25"
               FontWeight="DemiBold"/>
            <Label Grid.Row="3" Grid.Column="2"
               Name="TotalTicket"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               FontSize="25"
               FontWeight="DemiBold"/>
            <Label Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
               Name="DateAndPayMethod"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               FontSize="25"
               FontWeight="DemiBold"/>
            <Label Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
               Name="InOutDatetime"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               FontSize="25"
               FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                Click="Close_Click"
                FontSize="20"
                Margin="5,10,5,5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/cancel.png" Width="30" Height="30" Margin="5 5 5 0"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="5" Grid.Column="3"
                Name="PrintTicket"
                Click="PrintTicket_Click"
                FontSize="20"
                Margin="5,10,5,5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/printer_icon.png" Width="30" Height="30" Margin="5 5 5 0"/>
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <GroupBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                  Name="GroupBoxDataGrid"
                  Grid.RowSpan="3"
                  Header="DETALLE DE LA CUENTA">
                <DataGrid Name="TicketDetail"
                      Height="340" Width="700"
                      Margin="0,10,0,10"
                      RowHeight="30"
                      IsReadOnly="True"
                      FontSize="20"
                      FontWeight="DemiBold"
                      HorizontalAlignment="Left"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible" 
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="LightBlue"
                      BorderBrush="Gray" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                        Width="60"
                                        Binding="{Binding Path=ItemID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="258"
                                        Binding="{Binding Path=ItemDesc}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                        <DataGridTextColumn Header="CANT"
                                        Width="100"
                                        Binding="{Binding Path=Qty}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRECIO"
                                        Width="130"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOTAL"
                                        Width="125"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Border>
</Window>
