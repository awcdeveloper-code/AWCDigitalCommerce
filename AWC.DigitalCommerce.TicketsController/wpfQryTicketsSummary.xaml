<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfQryTicketsSummary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="450" Width="800" Background="Orange"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Red" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   Content="FECHA INICIAL:"
                   FontSize="15"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="2" Grid.Column="1"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   Content="FECHA FINAL:"
                   FontSize="15"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="3" Grid.Column="1"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   Content="TIPO DE PAGO:"
                   FontSize="15"
                   FontWeight="DemiBold"/>
            <DatePicker Grid.Row="1" Grid.Column="2"
                        Name="StartDay"
                        SelectedDateFormat="Short"
                        VerticalAlignment="Center"
                        FontWeight="DemiBold"
                        SelectedDateChanged="StartDay_SelectedDateChanged"/>
            <DatePicker Grid.Row="2" Grid.Column="2"
                        Name="EndDay"
                        SelectedDateFormat="Short"
                        VerticalAlignment="Center"
                        FontWeight="DemiBold"
                        SelectedDateChanged="EndDay_SelectedDateChanged"/>
            <ComboBox Grid.Row="3" Grid.Column="2"
                      Name="cbox_PaymentMethod"
                      VerticalAlignment="Center"
                      FontWeight="DemiBold" SelectionChanged="cbox_PaymentMethod_SelectionChanged" />
            <DataGrid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5"
                      Name="TicketDetail"
                      Height="270" Width="745"
                      RowHeight="30"
                      IsReadOnly="True"
                      FontSize="20"
                      FontWeight="DemiBold"
                      HorizontalAlignment="Left"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible" 
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightYellow"
                      AlternatingRowBackground="LightBlue"
                      BorderBrush="Gray" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA"
                                        Width="110"
                                        Binding="{Binding Path=TicketDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CUENTA"
                                        Width="90"
                                        Binding="{Binding Path=ID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="NOMBRE DEL CLIENTE"
                                        Width="415"
                                        Binding="{Binding Path=CustomerAKA}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="MONTO"
                                        Width="100"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Label Grid.Row="5" Grid.Column="5"
                   Foreground="DarkBlue"
                   Name="lblticketsSummaryTotal"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Content="0.00"
                   FontSize="30"
                   FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="1"
                    Name="btnCancel"
                    Click="btn_Cancel"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    Content="CERRAR"/>
            <Button Grid.Row="5" Grid.Column="2"
                    Name="btnExport"
                    Click="btn_Export"
                    FontSize="20"
                    Margin="5"
                    IsEnabled="False"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    Content="EXPORTAR"/>
        </Grid>
    </Border>
</Window>