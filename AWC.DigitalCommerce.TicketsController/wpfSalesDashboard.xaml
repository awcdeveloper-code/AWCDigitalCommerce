<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSalesDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        mc:Ignorable="d" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Window.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="Azure" Offset="0.0"/>
            <GradientStop Color="DarkBlue" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>
    <Border BorderBrush="Cyan" BorderThickness="3">
        <ScrollViewer>
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="40"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Resources>
            <Grid>
                <Grid.Resources>
                    <local:clsItemTypeCollection x:Key = "clsItemTypeCollection" />
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>
                <!--HEADER -->
                <Label Grid.Row="1" Grid.Column="1"
                       Foreground="DarkBlue"
                       Content="FECHA INICIAL:"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="DemiBold"/>
                <DatePicker Grid.Row="1" Grid.Column="2"
                    Name="StartDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="StartDate_SelectedDateChanged"/>
                <Label Grid.Row="2" Grid.Column="1"
                       Foreground="DarkBlue"
                       Content="FECHA FINAL:"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="DemiBold"/>
                <DatePicker Grid.Row="2" Grid.Column="2"
                    Name="FinishDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="FinishDate_SelectedDateChanged"/>
                <Label Grid.Row="1" Grid.Column="4" Grid.RowSpan="2"
                       Foreground="DarkBlue"
                       Content="PANEL DE VENTAS"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="30"
                       FontWeight="DemiBold"/>
                <!-- SEARCH BUTTON -->
                <Button Grid.Row="1" Grid.Column="3" Grid.RowSpan="2"
                        Name="btnSearch"
                        Click="btn_search"
                        FontSize="15"
                        Margin="5"
                        Cursor="Hand"
                        FontWeight="DemiBold"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/search.png"
                               Width="25" Height="25" Margin="5"/>
                        <TextBlock Text="BUSCAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- CHARTS STACKPANEL -->
                <StackPanel Grid.Row="3" Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Name="CharsStackPanel"
                            Margin="20"
                            Orientation="Vertical"
                            Visibility="Hidden">
                    <!-- Pie chart: 10 products more saled -->
                    <Label Content="Los 10 Más Vendidos"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="35"
                           FontWeight="DemiBold"/>
                    <DVC:Chart Canvas.Top="10" Canvas.Left="10"
                               Name="mcChartTab5"
                               VerticalAlignment="Center"
                               Width="1000" Height="500"
                               Margin="10"
                               Background="Azure">
                        <DVC:Chart.Series>
                            <DVC:PieSeries Name="PieItemsListSeriesTab5"
                                           Title="Cantidad"
                                           FontSize="10"
                                           ItemsSource = "{StaticResource clsItemTypeCollection}"
                                           IndependentValueBinding = "{Binding Path = ItemDesc}"
                                           DependentValueBinding = "{Binding Path = Qty}"
                                           IsSelectionEnabled="False">
                            </DVC:PieSeries>
                        </DVC:Chart.Series>
                    </DVC:Chart>
                    <DVC:Chart Canvas.Top="10" Canvas.Left="10"
                               Name="mcBartTab5"
                               VerticalAlignment="Center"
                               Width="1000" Height="500"
                               Margin="10"
                               Background="Azure">
                        <DVC:Chart.Series>
                            <DVC:ColumnSeries Name="BarItemsListSeriesTab5"
                                              Title="Precio"
                                              FontSize="10"
                                              ItemsSource = "{StaticResource clsItemTypeCollection}"
                                              IndependentValueBinding = "{Binding Path = ItemDesc}"
                                              DependentValueBinding = "{Binding Path = TotalPrice}"
                                              IsSelectionEnabled="False">
                            </DVC:ColumnSeries>
                        </DVC:Chart.Series>
                    </DVC:Chart>
                </StackPanel>
                <!-- CLOSE BUTTON -->
                <Button Grid.Row="4" Grid.Column="1"
                        Click="btn_close"
                        FontSize="15"
                        Margin="5"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/delete_sign.png"
                               Width="25" Height="25" Margin="5"/>
                        <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
