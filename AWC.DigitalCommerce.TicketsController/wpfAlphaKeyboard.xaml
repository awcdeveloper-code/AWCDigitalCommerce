<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfAlphaKeyboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="510" Width="850" Background="Cyan"
        ContentRendered="Window_ContentRendered"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Window.Resources>
        <DataTemplate x:Key="Prefixes_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding Prefix}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Blue" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--TEXTBOX-->
            <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="6"
                 Name="txtAlpha"
                 Background="LightCyan"
                 VerticalAlignment="Center"
                 FontSize="45"
                 Margin="5"
                 Padding="2"
                 FontWeight="DemiBold" KeyUp="txtAlpha_KeyUp"/>
            <!--1 2 3 4 5 6 7 8 9 0-->
            <Button Grid.Row="2" Grid.Column="1"
                Content="1"
                Click="btn_1"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="2"
                Content="2"
                Click="btn_2"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="3"
                Content="3"
                Click="btn_3"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="4"
                Content="4"
                Click="btn_4"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="5"
                Content="5"
                Click="btn_5"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="6"
                Content="6"
                Click="btn_6"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="7"
                Content="7"
                Click="btn_7"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="8"
                Content="8"
                Click="btn_8"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="9"
                Content="9"
                Click="btn_9"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="2" Grid.Column="10"
                Content="0"
                Click="btn_0"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <!--Q W E R T Y U I O P-->
            <Button Grid.Row="3" Grid.Column="1"
                Content="Q"
                Click="btn_Q"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="2"
                Content="W"
                Click="btn_W"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="3"
                Content="E"
                Click="btn_E"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="4"
                Content="R"
                Click="btn_R"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="5"
                Content="T"
                Click="btn_T"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="6"
                Content="Y"
                Click="btn_Y"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="7"
                Content="U"
                Click="btn_U"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="8"
                Content="I"
                Click="btn_I"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="9"
                Content="O"
                Click="btn_O"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="3" Grid.Column="10"
                Content="P"
                Click="btn_P"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <!--A S D F G H J K L-->
            <Button Grid.Row="4" Grid.Column="1"
                Content="A"
                Click="btn_A"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="2"
                Content="S"
                Click="btn_S"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="3"
                Content="D"
                Click="btn_D"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="4"
                Content="F"
                Click="btn_F"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="5"
                Content="G"
                Click="btn_G"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="6"
                Content="H"
                Click="btn_H"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="7"
                Content="J"
                Click="btn_J"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="8"
                Content="K"
                Click="btn_K"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="9"
                Content="L"
                Click="btn_L"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <!--Z X C V B N M-->
            <Button Grid.Row="5" Grid.Column="2"
                Content="Z"
                Click="btn_Z"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="3"
                Content="X"
                Click="btn_X"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="4"
                Content="C"
                Click="btn_C"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="5"
                Content="V"
                Click="btn_V"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="6"
                Content="B"
                Click="btn_B"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="7"
                Content="N"
                Click="btn_N"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="8"
                Content="M"
                Click="btn_M"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <!--BACK & OK-->
            <Button Grid.Row="5" Grid.Column="9"
                Content="Borre"
                Click="btn_Back"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"/>
            <Button Grid.Row="5" Grid.Column="10"
                    Content="OK"
                    Click="btn_OK"
                    FontSize="30"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold"/>
            <!--SPACEBAR-->
            <Button Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="8"
                    Content="ESPACIO"
                    Click="btn_SPACE"
                    FontSize="30"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold"/>
        </Grid>
    </Border>
</Window>
