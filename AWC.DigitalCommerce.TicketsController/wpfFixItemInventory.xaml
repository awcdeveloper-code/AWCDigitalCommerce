<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfFixItemInventory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="590" Width="450" Background="DarkBlue"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None">
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--LABELS-->
            <Label Grid.Row="1" Grid.Column="1"
               Name="lblItemID"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="0000"
               FontSize="50"
               FontWeight="DemiBold"/>
            <Label Grid.Row="3" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="SUBTIPO:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <Label Grid.Row="4" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="PARIENTE:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <Label Grid.Row="5" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="CANT PARIENTE:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <Label Grid.Row="6" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="DISPONIBLE:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <Label Grid.Row="7" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="VENDIDO:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <Label Grid.Row="8" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="DAÑADO:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <Label Grid.Row="9" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="MÍNIMO:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <Label Grid.Row="10" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="MÁXIMO:"
               FontSize="30"
               FontWeight="DemiBold"/>
            <!--TEXTBOXES-->
            <TextBox Grid.Row="3" Grid.Column="3"
                 Name="txtItemSubtype"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <TextBox Grid.Row="4" Grid.Column="3"
                 Name="txtItemParent"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <TextBox Grid.Row="5" Grid.Column="3"
                 Name="txtItemParentUnit"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <TextBox Grid.Row="6" Grid.Column="3"
                 Name="txtItemAvailable"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <TextBox Grid.Row="7" Grid.Column="3"
                 Name="txtItemSold"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <TextBox Grid.Row="8" Grid.Column="3"
                 Name="txtItemDefective"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <TextBox Grid.Row="9" Grid.Column="3"
                 Name="txtItemMinimum"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <TextBox Grid.Row="10" Grid.Column="3"
                 Name="txtItemStock"
                 PreviewTextInput="NumberValidationTextBox"
                 Margin="5"
                 Background="cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="30"
                 Text="0"
                 FontWeight="DemiBold" />
            <!--BUTTON OK-->
            <Button Grid.Row="12" Grid.Column="1"
                Click="btn_OK"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="ACEPTAR VALORES" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="12" Grid.Column="3"
                Click="btn_CNCL"
                Background="OrangeRed"
                Foreground="Black"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
