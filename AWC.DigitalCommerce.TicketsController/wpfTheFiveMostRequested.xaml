<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfTheFiveMostRequested"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        ContentRendered="Window_ContentRendered"
        mc:Ignorable="d" Height="850" Width="1000" ResizeMode="NoResize" Background="DarkBlue"
        WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Border BorderBrush="Fuchsia" BorderThickness="3">
        <Grid>
            <Grid.Resources>
                <local:clsItemTypeCollection x:Key = "BeveragesCollection" />
                <local:clsItemTypeCollection x:Key = "LiquoursCollection" />
                <local:clsItemTypeCollection x:Key = "MealsCollection" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="1"
                        Grid.ColumnSpan="3" Grid.Row="1"
                        Orientation="Vertical">
                <DVC:Chart Name="mcBeveragesChart"
                   VerticalAlignment="Center"
                   Width="900" Height="230" Margin="5"
                   Background="Cyan">
                    <DVC:Chart.Series>
                        <DVC:ColumnSeries Name="Beverages"
                                          Title="BEBIDAS"
                                          FontSize="10"
                                          ItemsSource = "{StaticResource BeveragesCollection}"
                                          IndependentValueBinding = "{Binding Path = ItemDesc}"
                                          DependentValueBinding = "{Binding Path = Qty}">
                            <DVC:ColumnSeries.DataPointStyle>
                                <Style TargetType="DVC:ColumnDataPoint">
                                    <Setter Property="Background" Value="DarkBlue"/>
                                </Style>
                            </DVC:ColumnSeries.DataPointStyle>
                        </DVC:ColumnSeries>
                    </DVC:Chart.Series>
                </DVC:Chart>
                <DVC:Chart Name="mcLiquoursChart"
                   VerticalAlignment="Center"
                   Width="900" Height="230" Margin="10"
                   Background="Cyan">
                    <DVC:Chart.Series>
                        <DVC:ColumnSeries Name="Liquors"
                                          Title="LICORES"
                                          FontSize="5"
                                          ItemsSource = "{StaticResource LiquoursCollection}"
                                          IndependentValueBinding = "{Binding Path = ItemDesc}"
                                          DependentValueBinding = "{Binding Path = Qty}">
                            <DVC:ColumnSeries.DataPointStyle>
                                <Style TargetType="DVC:ColumnDataPoint">
                                    <Setter Property="Background" Value="Lime"/>
                                </Style>
                            </DVC:ColumnSeries.DataPointStyle>
                        </DVC:ColumnSeries>
                    </DVC:Chart.Series>
                </DVC:Chart>
                <DVC:Chart Name="mcMealsChart"
                   VerticalAlignment="Center"
                   Width="900" Height="230" Margin="10"
                   Background="Cyan">
                    <DVC:Chart.Series>
                        <DVC:ColumnSeries Name="Meals"
                                          Title="COMIDAS"
                                          FontSize="5"
                                          ItemsSource = "{StaticResource MealsCollection}"
                                          IndependentValueBinding = "{Binding Path = ItemDesc}"
                                          DependentValueBinding = "{Binding Path = Qty}">
                            <DVC:ColumnSeries.DataPointStyle>
                                <Style TargetType="DVC:ColumnDataPoint">
                                    <Setter Property="Background" Value="Red"/>
                                </Style>
                            </DVC:ColumnSeries.DataPointStyle>
                        </DVC:ColumnSeries>
                    </DVC:Chart.Series>
                </DVC:Chart>
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="1"
                Click="btn_Close"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="3"
                    Name="ManualRefresh"
                    Click="btn_Refresh"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="ACTUALIZAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
