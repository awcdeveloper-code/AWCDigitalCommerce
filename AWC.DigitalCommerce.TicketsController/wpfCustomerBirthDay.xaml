<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfCustomerBirthDay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="400" Width="700" Background="Cyan"
        WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Grid.Column="0"
               Grid.RowSpan="4" Grid.ColumnSpan="3"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="UniformToFill"
               Name="BirthDay"
               Source="/Images/birthday.png"
               MouseDown="Click_MouseDown"/>
        <Label Grid.Row="1" Grid.Column="1"
               Name="lblHappyBirthday"
               Content="FELIZ CUMPLEAÑOS"
               HorizontalAlignment="Center"
               Foreground="Cyan"
               FontFamily="Impact"
               FontSize="60"/>
        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
               Name="lblCustomerName"
               HorizontalAlignment="Center"
               Foreground="White"
               FontFamily="Impact"
               FontSize="60"/>
    </Grid>
</Window>
