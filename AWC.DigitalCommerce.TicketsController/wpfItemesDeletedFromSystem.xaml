<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfItemesDeletedFromSystem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Background="Azure" Height="530" Width="980"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="lBox_Ticket_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Cyan" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="370"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--DATE RANGE-->
            <Label Grid.Row="1" Grid.Column="1"
               Foreground="DarkBlue"
               Content="FECHA INICIAL:"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="DemiBold"/>
            <DatePicker Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                    Name="StartDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="StartDate_SelectedDateChanged"/>
            <Label Grid.Row="2" Grid.Column="1"
               Foreground="DarkBlue"
               Content="FECHA FINAL:"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="DemiBold"/>
            <DatePicker Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                    Name="FinishDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="FinishDate_SelectedDateChanged"/>
            <Label Grid.Row="1" Grid.Column="4"
                   Foreground="DarkBlue"
                   Content="PRODUCTOS ELIMINADOS DEL SISTEMA"
                   VerticalAlignment="Center"
                   FontSize="23"
                   FontWeight="DemiBold"/>
            <!--TICKET-->
            <DataGrid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="6"
                      Name="TicketsList"
                      Height="355" Width="945"
                      Margin="5"
                      RowHeight="25"
                      FontSize="18"
                      FontWeight="DemiBold"
                      IsReadOnly="True"
                      HorizontalAlignment="Left"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible" 
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="DarkBlue" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA"
                                        Width="120"
                                        Binding="{Binding Path=TicketDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ID"
                                        Width="100"
                                        Binding="{Binding Path=ItemID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                    Width="300"
                                    Binding="{Binding Path=ItemDescription}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="COLABORADOR"
                                    Width="200"
                                    Binding="{Binding Path=WhoDeletedName}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="FECHA/HORA"
                                    Width="200"
                                    Binding="{Binding Path=DeletedAtString}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Label Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="7"
               Name="AbortReason"
               VerticalAlignment="Center"
               FontSize="15"
               FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="1"
                Click="btn_Close"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
