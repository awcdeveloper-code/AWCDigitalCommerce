<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfIncomeCash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Background="DarkBlue" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Height="650" Width="1100">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Cyan" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1"
               Foreground="Cyan"
               Content="FECHA INICIAL:"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="DemiBold"/>
            <DatePicker Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                    Name="StartDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="StartDate_SelectedDateChanged"/>
            <Label Grid.Row="2" Grid.Column="1"
               Foreground="Cyan"
               Content="FECHA FINAL:"
               VerticalAlignment="Center"
               FontSize="18"
               FontWeight="DemiBold"/>
            <DatePicker Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                    Name="FinishDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="FinishDate_SelectedDateChanged"/>
            <Label Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="6"
                   Foreground="Cyan"
                   Content="INGRESOS DE EFECTIVO A LA CAJA"
                   VerticalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <DataGrid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="9"
                  Name="IncomeCashList"
                  Height="470" Width="935"
                  Margin="5"
                  RowHeight="25"
                  FontSize="18"
                  FontWeight="DemiBold"
                  IsReadOnly="True"
                  HorizontalAlignment="Left"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible" 
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="LightGray"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  BorderBrush="DarkBlue" BorderThickness="2"
                  AreRowDetailsFrozen="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA"
                                        Width="100"
                                        Binding="{Binding Path=BusinessDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCIÓN DEL INGRESO"
                                        Width="360"
                                        Binding="{Binding Path=IncomeDescription}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="MONTO"
                                        Width="80"
                                        Binding="{Binding Path=IncomeAmount, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="QUIÉN LO INGRESÓ"
                                        Width="180"
                                        Binding="{Binding Path=WhoDidIt}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="FECHA/HORA"
                                        Width="185"
                                        Binding="{Binding Path=CreatedAt}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="4" Grid.Column="1"
                    Click="btn_Close"
                    FontSize="15"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Label Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="6"
                   Foreground="Cyan"
                   Content="TOTAL DE INGRESOS:"
                   VerticalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="4" Grid.Column="8" Grid.ColumnSpan="2"
                   Name="lblTotalCashIncome"
                   Foreground="Cyan"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"/>
        </Grid>
    </Border>
</Window>
