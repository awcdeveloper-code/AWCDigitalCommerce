<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfFastTrack"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Width="1180" Height="710" WindowStyle="None" Background="Cyan"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="lBox_Customer_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="red" BorderThickness="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="12.302"/>
                <ColumnDefinition Width="87.698"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--TICKETS SECTION-->
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
               Name="lblCustomersList"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               Content="AVAILABLE TICKETS:"
               FontSize="20"
               FontWeight="DemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                 Name="txtSearchCustomer"
                 Background="White"
                 VerticalAlignment="Center"
                 FontSize="25"
                 Margin="5,0,5,0"
                 BorderBrush="DarkBlue" BorderThickness="2"
                 FontWeight="DemiBold"
                 TextChanged="txtSearchCustomer_TextChanged"
                 GotFocus="txtSearchCustomer_GotFocus" />
            <ListBox Grid.Row="3" Grid.Column="1"
                 Grid.ColumnSpan="3"
                 Grid.RowSpan="6"
                 Name="lBox_Customers"
                 Margin="5,5,5,5"
                 BorderBrush="DarkBlue" BorderThickness="2"
                 FontSize="20"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ItemTemplate="{StaticResource lBox_Customer_DataTemplate}"
                 SelectionChanged="lBox_Customer_SelectionChanged">
            </ListBox>
            <!--PRODUCTS SECTION-->
            <Label Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3"
               Name="lblProductsList"
               Foreground="DarkBlue"
               VerticalAlignment="Center"
               Content="PRODUCTS LIST:"
               FontSize="20"
               FontWeight="DemiBold"/>
            <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                 Name="txtSearchProduct"
                 IsEnabled="False"
                 Background="White"
                 VerticalAlignment="Center"
                 FontSize="25"
                 Margin="5,0,5,0"
                 BorderBrush="DarkBlue" BorderThickness="2"
                 FontWeight="DemiBold"
                 TextChanged="txtSearchProduct_TextChanged"
                 GotFocus="txtSearchProduct_GotFocus" />
            <ListBox Grid.Row="11" Grid.Column="1"
                 Grid.ColumnSpan="3"
                 Grid.RowSpan="4"
                 Name="lBox_Products"
                 IsEnabled="False"
                 Margin="5,5,5,5"
                 BorderBrush="DarkBlue" BorderThickness="2"
                 FontSize="20"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ItemTemplate="{StaticResource Items_DataTemplate}"
                 SelectionChanged="lBox_Products_SelectionChanged">
            </ListBox>
            <Label Grid.Row="15" Grid.Column="1"
               Name="lblQuantity"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Content="CANT:"
               FontSize="25"
               FontWeight="DemiBold"/>
            <TextBox Grid.Row="15" Grid.Column="2"
                 Name="txtProductQty"
                 Background="Cyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Center"
                 FontSize="25"
                 Margin="5,0,5,0"
                 BorderBrush="DarkBlue" BorderThickness="2"
                 IsEnabled="False"
                 FontWeight="DemiBold"
                 GotFocus="txtProductQty_GotFocus" />
            <Image Grid.Row="15" Grid.Column="3"
               Name="AddProduct"
               Source="/Images/Plus_sign.png"
               Margin="5"
               IsEnabled="False"
               Cursor="Hand"
               MouseDown="btn_AddProduct"/>
            <!--TICKET DETAIL DATAGRID-->
            <Label Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                   Name="lblTicketNumber"
                   Content="CUENTA:"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="2"
                   Foreground="DarkBlue"
                   Content="10% SERVICIO:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="9"
                   Name="lblServiceFee"
                   Foreground="DarkBlue"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="10"
                   Foreground="DarkBlue"
                   Content="TOTAL:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="12"
                   Name="lblTotalPrice"
                   Foreground="DarkBlue"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <DataGrid Grid.Row="2" Grid.Column="4"
                  Grid.ColumnSpan="9"
                  Grid.RowSpan="7"
                  Name="TicketDetail"
                  Height="305" Width="790"
                  RowHeight="30"
                  FontSize="20"
                  FontWeight="DemiBold"
                  Margin="5,5,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Hidden"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="White"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  BorderBrush="DarkBlue" BorderThickness="2"
                  AreRowDetailsFrozen="True"
                  FrozenColumnCount="2"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False"
                  SelectionChanged="TicketDetail_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                    Width="75"
                                    Binding="{Binding Path=ItemID}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                    Width="360"
                                    Binding="{Binding Path=ItemDesc}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="CANT"
                                    Width="85"
                                    Binding="{Binding Path=Qty}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PRECIO"
                                    Width="115"
                                    Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TOTAL"
                                    Width="125"
                                    Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!--BUTTONS SECTION-->
            <Button Grid.Row="9" Grid.Column="4"
                Name="CloseFastTrack"
                Click="btn_Close"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="CLOSE"/>
            <Button Grid.Row="9" Grid.Column="5"
                Name="CreateTicket"
                Click="btn_CreateTicket"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="CREATE"/>
            <Button Grid.Row="9" Grid.Column="6"
                Name="PrintTicket"
                Click="btn_PrintTicket"
                IsEnabled="False"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="PRINT"/>
            <Button Grid.Row="9" Grid.Column="7"
                Name="AbortTicket"
                Click="btn_AbortTicket"
                IsEnabled="False"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="ABORT"/>
            <Button Grid.Row="9" Grid.Column="8"
                Name="CancelUpdate"
                Click="btn_CancelUpdate"
                IsEnabled="False"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="CANCEL"/>
            <Button Grid.Row="9" Grid.Column="9"
                Name="UpdateTicket"
                Click="btn_UpdateTicket"
                IsEnabled="False"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="UPDATE"/>
            <Button Grid.Row="9" Grid.Column="10"
                Name="SmallPayment"
                Click="btn_SmallPayment"
                IsEnabled="False"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="CREDIT"/>
            <Button Grid.Row="9" Grid.Column="11"
                Name="PayTicket"
                Click="btn_PayTicket"
                IsEnabled="False"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="PAY" Grid.ColumnSpan="2"/>
            <Button Grid.Row="10" Grid.Column="4"
                Name="Express"
                Click="btn_Express"
                FontSize="15"
                Margin="5,5,5,5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="EXPRESS"/>
            <Button Grid.Row="10" Grid.Column="5"
                Name="SplitTicket"
                Click="btn_SplitTicket"
                FontSize="15"
                Margin="5,5,5,5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="SPLIT"/>
            <!--CHECKBOXES-->
            <CheckBox Grid.Row="11" Grid.Column="4" Grid.ColumnSpan="2"
                  Name="ApplyServiceFee"
                  Click="ApplyServiceFee_Click"
                  Foreground="DarkBlue"
                  VerticalAlignment="Center"
                  IsChecked="False"
                  IsEnabled="False"
                  Margin="5,0,5,0"
                  FontSize="15"
                  FontWeight="DemiBold"
                  Content="APLICAR 10% SERVICIO:"/>
            <CheckBox Grid.Row="12" Grid.Column="4" Grid.ColumnSpan="2"
                  Name="PrintSummary"
                  Click="chkBox_PrintSummary_Click"
                  Foreground="DarkBlue"
                  VerticalAlignment="Center"
                  IsChecked="False"
                  Margin="5,0,5,0"
                  FontSize="15"
                  FontWeight="DemiBold"
                  Content="AGRUPAR PRODUCTOS"/>
            <CheckBox Grid.Row="13" Grid.Column="4" Grid.ColumnSpan="3"
                  Name="PrintClosedTicket"
                  Click="chkBox_PrintClosedTicket"
                  Foreground="DarkBlue"
                  VerticalAlignment="Center"
                  IsChecked="False"
                  Margin="5,0,5,0"
                  FontSize="15"
                  FontWeight="DemiBold"
                  Content="IMPRIMIR CUENTA CANCELADA"/>
            <!--ADD & SUBSTRACT BUTTONS-->
            <Image Grid.Row="4" Grid.Column="13"
               Name="Increase"
               Source="/Images/Plus_sign.png"
               Margin="5,5,5,5"
               Visibility="Hidden"
               ToolTip="Clic para sumar una unidad."
               Cursor="Hand"
               MouseDown="btn_Increase"/>
            <Image Grid.Row="5" Grid.Column="13"
               Name="Delete"
               Source="/Images/Delete_sign.png"
               Margin="5,5,5,5"
               Visibility="Hidden"
               ToolTip="Clic para eliminar el item."
               Cursor="Hand"
               MouseDown="btn_Delete"/>
            <Image Grid.Row="6" Grid.Column="13"
               Name="Decrease"
               Source="/mages/Minus_sign.png"
               Margin="5,5,5,5"
               Visibility="Hidden"
               ToolTip="Clic para restar una unidad."
               Cursor="Hand"
               MouseDown="btn_Decrease"/>
            <Image Grid.Row="7" Grid.Column="13"
               Name="PrintMeal"
               Source="/Images/printer_icon.png"
               Margin="5,5,5,5"
               Visibility="Hidden"
               ToolTip="Clic para Reimprimir la comanda."
               Cursor="Hand"
               MouseDown="btn_PrintMeal"/>
            <!--SALES SUMMARY-->
            <Label Grid.Row="10" Grid.Column="9" Grid.ColumnSpan="2"
                   Name="lbl_TotalReceivable"
                   Foreground="MediumVioletRed"
                   Content="POR COBRAR:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="10" Grid.Column="12"
                   Name="lblTotalReceivable"
                   Foreground="MediumVioletRed"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold" />
            <Label Grid.Row="11" Grid.Column="9" Grid.ColumnSpan="2"
                   Name="lbl_TotalCash"
                   Foreground="MediumVioletRed"
                   Content="EFECTIVO:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="11" Grid.Column="12"
                   Name="lblTotalCash"
                   Foreground="MediumVioletRed"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="12" Grid.Column="9" Grid.ColumnSpan="2"
                   Name="lbl_TotalCreditCard"
                   Foreground="MediumVioletRed"
                   Content="TARJ CRED:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="12" Grid.Column="12"
                   Name="lblTotalCreditCard"
                   Foreground="MediumVioletRed"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="13" Grid.Column="9" Grid.ColumnSpan="2"
                   Name="lbl_TotalTransfer"
                   Foreground="MediumVioletRed"
                   Content="TRANSFER:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="13" Grid.Column="12"
                   Name="lblTotalTransfer"
                   Foreground="MediumVioletRed"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="14" Grid.Column="9" Grid.ColumnSpan="2"
                   Name="lbl_TotalSale"
                   Foreground="MediumVioletRed"
                   Content="VENTA TOTAL:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="14" Grid.Column="12"
                   Name="lblTotalSale"
                   Foreground="MediumVioletRed"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="15" Grid.Column="9" Grid.ColumnSpan="2"
                   Name="lbl_TotalServiceFee"
                   Foreground="DarkGreen"
                   Content="10% SERVICIO:"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="15" Grid.Column="12"
                   Name="lblTotalServiceFee"
                   Foreground="DarkGreen"
                   Content="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="20"
                   Margin="5"
                   FontWeight="DemiBold"/>
            <TextBlock Grid.Row="10" Grid.Column="8"
                       Grid.RowSpan="5"
                       Name="lbl_TotalSalesRealTime"
                       FontSize="25"
                   Margin="5"
                       FontWeight="DemiBold"
                       Foreground="MediumVioletRed"
                       VerticalAlignment="Center">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </TextBlock.LayoutTransform>
                    ACUMULADOS
            </TextBlock>
        </Grid>
    </Border>
</Window>
