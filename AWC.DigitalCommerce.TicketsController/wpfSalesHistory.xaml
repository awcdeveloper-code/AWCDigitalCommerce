<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSalesHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="650" Width="400" ResizeMode="NoResize"
        Background="Cyan" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Title="HISTORIAL DE VENTAS" >
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="1"
               Content="FECHA INICIAL:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="20"
               FontWeight="DemiBold"/>
        <DatePicker Grid.Row="1" Grid.Column="2"
                    Name="StartDay"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="StartDay_SelectedDateChanged"/>
        <Label Grid.Row="2" Grid.Column="1"
               Content="FECHA FINAL:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="20"
               FontWeight="DemiBold"/>
        <DatePicker Grid.Row="2" Grid.Column="2"
                    Name="EndDay"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="EndDay_SelectedDateChanged"/>
        <GroupBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                  Name="GroupBoxDataGrid"
                  FontSize="20"
                  FontWeight="DemiBold"
                  HorizontalAlignment="Center"
                  Header="VENTAS AGRUPADAS POR FECHA">
            <DataGrid Name="SalesByDate"
                      Height="350" Width="350"
                      Margin="5"
                      FontSize="30"
                      RowHeight="35"
                      IsReadOnly="True"
                      HorizontalAlignment="Center"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible" 
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightYellow"
                      AlternatingRowBackground="LightCyan"
                      BorderBrush="Gray" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA"
                                        Width="160"
                                        Binding="{Binding Path=salesDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TOTAL"
                                        Width="160"
                                        Binding="{Binding Path=salesTotal, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <Label Grid.Row="5" Grid.Column="1"
               Content="TOTAL:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="30"
               FontWeight="DemiBold"/>
        <Label Grid.Row="5" Grid.Column="2"
               Name="lblTotalAmount"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="30"
               FontWeight="DemiBold"/>
        <Button Grid.Row="7" Grid.Column="1"
                Name="Cancel"
                Click="btn_Cancel"
                Background="DarkBlue"
                Foreground="White"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="7" Grid.Column="2"
                Name="PrintsSalesHistory"
                Click="btn_PrintsSalesHistory"
                Background="DarkBlue"
                Foreground="White"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/printer_icon.png"
                           Width="25" Height="25" Margin="5"/>
                <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
