<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfWaitrestMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d"
        ContentRendered="wpfWaitrestMain_ContentRendered"
        Height="768" Width="1366"  Background="Indigo"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="lBox_Customer_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="35"
                           Foreground="Black"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="20"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="166"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <!--LEFT PANEL-->
        <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                 Name="txtSearchCustomer"
                 Background="Cyan"
                 Margin="3"
                 FontSize="40"
                 FontWeight="DemiBold"
                 GotFocus="txtSearchCustomer_GotFocus"
                 TextChanged="txtSearchCustomer_TextChanged" />
        <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                 Grid.RowSpan="1"
                 Name="lBox_Customers"
                 Margin="3"
                 Background="LightCyan"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ItemTemplate="{StaticResource lBox_Customer_DataTemplate}"
                 SelectionChanged="lBox_Customer_SelectionChanged" >
            <ListBox.Resources>
                <Style TargetType="ScrollBar">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="40"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Resources>
        </ListBox>
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Name="OpenTicket"
                Click="btn_OpenTicket"
                FontSize="35"
                Margin="3"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="ABRIR CUENTA"/>
        <!--TICKET DETAIL HEADER-->
        <Label Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                Name="lblTicketNumber"
                Foreground="Cyan"
                Content="CUENTA:"
                VerticalAlignment="Center"
                FontSize="40"
                FontWeight="DemiBold"/>
        <Image Grid.Row="0" Grid.Column="5"
               Name="FoodService"
               Source="/Images/food-service.png"
               Width="60" Height="60"
               Visibility="Hidden"
               MouseDown="btn_Increase"/>
        <Label Grid.Row="0" Grid.Column="7" Grid.ColumnSpan="2"
                Name="lblTotalAmount"
                Foreground="Cyan"
                Content="TOTAL: 0.00 "
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="40"
                FontWeight="DemiBold"/>
        <DataGrid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="6"
                  Name="TicketDetail"
                  Height="610" Width="910"
                  RowHeight="50"
                  FontSize="30"
                  FontWeight="DemiBold"
                  HorizontalAlignment="Left"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalAlignment="Top"
                  VerticalContentAlignment="Center"
                  VerticalScrollBarVisibility="Visible"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="LightGray"
                  RowBackground="LightYellow"
                  AlternatingRowBackground="Orange"
                  AreRowDetailsFrozen="True"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False"
                  SelectionChanged="TicketDetail_SelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="ScrollBar">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="40"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="DESCRIPCIÓN"
                                    Width="525"
                                    Binding="{Binding Path=ItemDesc}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                <DataGridTextColumn Header="CANT"
                                    Width="90"
                                    Binding="{Binding Path=Qty}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PRECIO"
                                    Width="120"
                                    Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TOTAL"
                                    Width="125"
                                    Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!--TICKET DETAIL FOOTER-->
        <Button Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                Name="AddProducts"
                Click="btn_AddProducts"
                FontSize="35"
                Margin="3"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="INCLUIR ORDEN"/>
        <Image Grid.Row="2" Grid.Column="5"
               Name="Increase"
               Source="/Images/Plus_sign.png"
               Width="80" Height="80"
               Visibility="Hidden"
               MouseDown="btn_Increase"/>
        <Image Grid.Row="2" Grid.Column="6"
               Name="Decrease"
               Source="/Images/Minus_sign.png"
               Width="80" Height="80"
               Visibility="Hidden"
               MouseDown="btn_Decrease"/>
        <Button Grid.Row="2" Grid.Column="7" Grid.ColumnSpan="2"
                Name="PayTicket"
                Click="btn_PayTicket"
                FontSize="35"
                Margin="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold"
                Content="PAGAR"/>
    </Grid>
</Window>
