<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfDailyCloseSummary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="600" Width="750"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" Background="DarkBlue">
    <Border BorderBrush="Fuchsia" BorderThickness="2">
        <Grid Margin="0,1,0,-1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="380"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            
            <!-- header -->
            <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                   Foreground="Cyan"
                   FontSize="25" FontWeight="DemiBold"
                   Content="RESUMEN DE CIERRE"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <!-- left body -->
            <StackPanel Grid.Column="1" Grid.Row="2"
                        Orientation="Vertical"
                        Margin="5">
                <Label Foreground="Cyan"
                       FontSize="20" FontWeight="DemiBold"
                       Content="SELECCIONE LA FECHA"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                <Calendar Name="calDate"
                          SelectedDatesChanged="calDate_SelectedDatesChanged"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Label Foreground="Cyan"
                           FontSize="20" FontWeight="DemiBold"
                           Content="TURNO:"/>
                    <TextBox Name="txtShift"
                             Width="50" Height="30"
                             Margin="5 0 0 0"
                             FontSize="20" FontWeight="DemiBold"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Text="1"/>
                </StackPanel>
                
                <!-- search and print buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button Click="btn_Search"
                            Name="Search"
                            FontSize="15"
                            Width="130"
                            Margin="5"
                            Cursor="Hand"
                            IsEnabled="False"
                            FontWeight="DemiBold">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/next.png"
                                       Width="30" Height="30" Margin="5"/>
                                <TextBlock Text="BUSCAR"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                    </Button>
                    <Button Click="btn_Print"
                            Name="Print"
                            FontSize="15"
                            Width="130"
                            Margin="5"
                            Cursor="Hand"
                            IsEnabled="False"
                            FontWeight="DemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/printer_icon.png"
                                       Width="30" Height="30" Margin="5"/>
                            <TextBlock Text="IMPRIMIR"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- exit -->
                <Button Click="btn_Cancel"
                        FontSize="15"
                        Width="130"
                        Margin="0 20 0 0"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/cancel.png"
                                   Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="CERRAR"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- right body -->
            <StackPanel Grid.Column="2" Grid.Row="2"
                        Grid.RowSpan="3"
                        Margin="10 0 0 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    
                    <!-- icons -->
                    <Image Source="Images/star.png" 
                           Grid.Row="0" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/cash_icon.png" 
                           Grid.Row="1" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/a2p2.png" 
                           Grid.Row="2" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/cash_icon.png" 
                           Grid.Row="3" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/creditcard_icon.png" 
                           Grid.Row="4" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/sinpe_icon.png" 
                           Grid.Row="5" Grid.Column="0"
                           Height="35"/>
                    <Image Source="/Images/voucher-94.png" 
                           Grid.Row="6" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/sales.png" 
                           Grid.Row="7" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/sales.png" 
                           Grid.Row="8" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/waitress.png" 
                           Grid.Row="9" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/money_icon.png" 
                           Grid.Row="10" Grid.Column="0"
                           Height="35"/>
                    <Image Source="Images/expenses.png" 
                           Grid.Row="11" Grid.Column="0"
                           Height="35"/>

                    <!-- labels -->
                    <Label Grid.Row="0" Grid.Column="1"
                           Content="CAJA INICIAL (CI) :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="0" Grid.Column="2"
                           Name="lbl_InitialCash"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           Content="INGRESOS CAJA (IC) :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="1" Grid.Column="2"
                           Name="lbl_IncomeCash"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="2" Grid.Column="1"
                           Content="CUENTAS ABIERTAS :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="2" Grid.Column="2"
                           Name="lbl_OutstandingAmount"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="3" Grid.Column="1"
                           Content="CI + IC + EFECTIVO - G :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="3" Grid.Column="2"
                           Name="lbl_Cash"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="4" Grid.Column="1"
                           Content="TARJETA CRÉDITO :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="4" Grid.Column="2"
                           Name="lbl_CreditCard"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="5" Grid.Column="1"
                           Content="SINPE :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="5" Grid.Column="2"
                           Name="lbl_Transfer"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="6" Grid.Column="1"
                           Content="VOUCHERS :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="6" Grid.Column="2"
                           Name="lbl_Voucher"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="7" Grid.Column="1"
                           Content="VENTA BRUTA :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="7" Grid.Column="2"
                           Name="lbl_TotalSale"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="8" Grid.Column="1"
                           Content="VENTA NETA :"
                           Foreground="Cyan"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="8" Grid.Column="2"
                           Name="lbl_NetSale"
                           Foreground="Cyan"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="9" Grid.Column="1"
                           Content="10% SERVICIO :"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="9" Grid.Column="2"
                           Name="lbl_ServiceFee"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="10" Grid.Column="1"
                           Content="ABONOS + PAGOS CXC :"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="10" Grid.Column="2"
                           Name="lbl_OldTicketsPay"
                           Content="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="11" Grid.Column="1"
                           Content="GASTOS + VALES (G):"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="11" Grid.Column="2"
               Name="lbl_Expenses"
               Content="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Foreground="White"
               FontSize="25"
               FontWeight="DemiBold"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
