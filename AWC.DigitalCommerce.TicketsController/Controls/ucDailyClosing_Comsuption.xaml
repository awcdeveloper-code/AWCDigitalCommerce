<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucDailyClosing_Comsuption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" Background="DarkBlue"
             d:DesignHeight="530" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="340"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="1"
               Foreground="Cyan"
               Content="FECHA INICIAL:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="18"
               FontWeight="DemiBold"/>
        <DatePicker Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                    Name="StartDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="StartDate_SelectedDateChanged"/>
        <Label Grid.Row="1" Grid.Column="4"
               Foreground="Cyan"
               Content="FECHA FINAL:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="18"
               FontWeight="DemiBold"/>
        <DatePicker Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2"
                    Name="FinishDate"
                    Foreground="DarkBlue"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="FinishDate_SelectedDateChanged"/>
        <Label Grid.Row="2" Grid.Column="1"
               Foreground="Cyan"
               Content="CONSUMO:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="20"
               FontWeight="DemiBold"/>
        <ComboBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                  Name="cbox_ItemType"
                  VerticalAlignment="Center"
                  FontSize="18"
                  FontWeight="DemiBold"
                  SelectionChanged="cbox_ItemType_SelectionChanged"/>
        <!--DATAGRID-->
        <GroupBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="6"
                  Foreground="Cyan"
                  Name="GroupBoxDataGrid"
                  FontSize="20"
                  FontWeight="DemiBold"
                  Header="DETALLE">
            <DataGrid Name="TicketDetail"
                      Height="290" Width="740"
                      Margin="5"
                      RowHeight="30"
                      IsReadOnly="True"
                      HorizontalAlignment="Left"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible" 
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="Gray" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CANT"
                                        Width="80"
                                        Binding="{Binding Path=Qty}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="370"
                                        Binding="{Binding Path=ItemDesc}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="PRECIO"
                                        Width="130"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TOTAL"
                                        Width="130"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <Button Grid.Row="5" Grid.Column="1"
                Name="PrintConsumption"
                Click="btn_PrintConsumption"
                Background="DarkBlue"
                Foreground="White"
                IsEnabled="False"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/printer_icon.png"
                       Width="20" Height="20" Margin="3"/>
                <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Label Grid.Row="5" Grid.Column="2"
               Foreground="Cyan"
               Content="TOTAL:"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="25"
               FontWeight="DemiBold"/>
        <Label Grid.Row="5" Grid.Column="3"
               Name="lblTotalSale"
               Foreground="Cyan"
               Content="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               FontSize="25"
               FontWeight="DemiBold"/>
    </Grid>
</UserControl>
