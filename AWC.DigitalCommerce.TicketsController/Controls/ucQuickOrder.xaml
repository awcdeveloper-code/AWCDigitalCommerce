<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucQuickOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" d:DesignHeight="660" d:DesignWidth="1300"
             Background="DarkBlue">
    <UserControl.Resources>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Orientation="Horizontal"
                        Margin="1">
                <Image Source="{Binding ImagePath}"
                       Width="25" Height="25"
                       Margin="0,0,5,0"/>
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="40"/>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="3">
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="450"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>
                <!--PRODUCT SELECTION-->
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                     Name="txtSearchProduct"
                     Background="Cyan"
                     VerticalAlignment="Center"
                     Margin="5"
                     FontSize="20"
                     FontWeight="DemiBold"
                     TextChanged="txtSearchProduct_TextChanged"
                     GotFocus="txtSearchProduct_GotFocus" />
                <ListBox Grid.Row="2" Grid.Column="1"
                         Grid.ColumnSpan="3" Grid.RowSpan="2"
                         Name="lBox_Products"
                         ItemTemplate="{StaticResource Items_DataTemplate}"
                         VerticalAlignment="Stretch"
                         Margin="5,0,5,5" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         FontSize="20"
                         SelectionMode="Single"
                         SelectionChanged="lBox_Products_SelectionChanged">
                </ListBox>
                <Label Grid.Row="4" Grid.Column="1"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="CANT:"
                   FontSize="30"
                   FontWeight="DemiBold"/>
                <TextBox Grid.Row="4" Grid.Column="2"
                     Name="txtQtyProduct"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="80"
                     FontSize="40"
                     IsEnabled="False"
                     FontWeight="DemiBold"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     GotFocus="txtQtyProduct_GotFocus"/>
                <Image Grid.Row="4" Grid.Column="3"
                   Name="AddProduct"
                   Source="/Images/Plus_sign.png"
                   Margin="5"
                   IsEnabled="False"
                   Cursor="Hand"
                   MouseDown="btn_AddProduct"/>
                <DataGrid Grid.Row="1" Grid.Column="5"
                      Grid.ColumnSpan="7" Grid.RowSpan="2"
                      Name="TicketDetail"
                      Height="480" Width="730"
                      RowHeight="35"
                      FontSize="25"
                      FontWeight="DemiBold"
                      IsReadOnly="True"
                      HorizontalScrollBarVisibility="Hidden"
                      HorizontalAlignment="Left"
                      VerticalScrollBarVisibility="Visible"
                      VerticalAlignment="Top"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightCyan"
                      RowBackground="Cyan"
                      AlternatingRowBackground="White"
                      BorderBrush="DarkBlue"
                      AreRowDetailsFrozen="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False"
                      SelectionChanged="TicketDetail_SelectionChanged"
                      LostFocus="TicketDetail_LostFocus">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="DESCRIPCIÓN"
                                            Width="420"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding ImagePath}"
                                           Width="30" Height="30"
                                           Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Path=ItemDesc}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="CANT"
                                        Width="72"
                                        Binding="{Binding Path=Qty}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRECIO"
                                        Width="95"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOTAL"
                                        Width="95"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <CheckBox Grid.Row="3" Grid.Column="5"
                      Name="PrintClosedTicket"
                      Click="chkBox_PrintClosedTicket"
                      VerticalAlignment="Center"
                      Foreground="Cyan"
                      Margin="5"
                      FontSize="15"
                      FontWeight="DemiBold"
                      Content="IMPRIMIR">
                </CheckBox>
                <CheckBox Grid.Row="3" Grid.Column="6"
                      Name="SuperQuickSale"
                      Click="chkBox_SuperQuickSale"
                      VerticalAlignment="Center"
                      Foreground="Cyan"
                      Margin="5"
                      FontSize="15"
                      FontWeight="DemiBold"
                      Content="PAGO RÁPIDO">
                </CheckBox>
                <Label Grid.Row="3" Grid.Column="8" Grid.ColumnSpan="2"
                   Name="lblTotalSale"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Content="TOTAL: 0"
                   FontSize="25"
                   FontWeight="DemiBold"/>
                <Button Grid.Row="4" Grid.Column="5"
                    Name="Cancel"
                    Click="btn_Cancel"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <Image Source="/Images/Delete_sign.png" Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="CANCELAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4" Grid.Column="6"
                    Name="Usual"
                    Click="btn_Usual"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <Image Source="/Images/Usually.png"  Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="USUALES" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4" Grid.Column="7"
                    Name="PrintMeal"
                    Click="btn_PrintMeal"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <Image Source="/Images/printer_icon.png" Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="COMANDA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4" Grid.Column="8"
                    Name="Discount"
                    Click="btn_Discount"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <Image Source="/Images/discount.png" Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="DESCUENTO" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4" Grid.Column="9"
                    Name="Payment"
                    Click="btn_Payment"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Vertical">
                        <Image Source="/Images/money_icon.png" Width="30" Height="30" Margin="5 5 5 0"/>
                        <TextBlock Text="PAGAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="7" Grid.Row="3" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Image Grid.Row="3" Grid.Column="7"
                       Margin="0 0 20 0"
                       Width="40"
                       Height="40"
                       Name="Increase"
                       Source="/Images/Plus_sign.png"
                       ToolTip="Clic para agregar un item."
                       Cursor="Hand"
                       Visibility="Hidden"
                       MouseDown="btn_Increase"/>
                    <Image Grid.Row="3" Grid.Column="7"
                       Margin="0 0 20 0"
                       Width="40"
                       Height="40"
                       Name="Delete"
                       Source="/Images/Delete_sign.png"
                       ToolTip="Clic para eliminar el item."
                       Cursor="Hand"
                       Visibility="Hidden"
                       MouseDown="btn_Delete"/>
                    <Image Grid.Row="3" Grid.Column="7"
                       Margin="0 0 20 0"
                       Width="40"
                       Height="40"
                       Name="Decrease"
                       Source="/Images/Minus_sign.png"
                       ToolTip="Clic para eliminar el item."
                       Cursor="Hand"
                       Visibility="Hidden"
                       MouseDown="btn_Decrease"/>
                </StackPanel>
                <StackPanel Grid.Column="10" Grid.Row="2"
                            Orientation="Vertical">
                    <Button Name="Cash" Foreground="DarkBlue"
                        Width="120" Height="80"
                        Click="btn_Cash"
                        FontSize="20"
                        Margin="5"
                        IsEnabled="False"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/Images/cash_icon.png" Width="30" Height="30" Margin="5 5 5 0"/>
                            <TextBlock Text="EFECTIVO"
                                   VerticalAlignment="Center"
                                   Margin="5" />
                        </StackPanel>
                    </Button>
                    <Button Name="CreditCard" Foreground="DarkBlue"
                        Width="120" Height="80"
                        Click="btn_CreditCard"
                        FontSize="20"
                        Margin="5"
                        IsEnabled="False"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/Images/creditcard_icon.png" Width="30" Height="30" Margin="5 5 5 0"/>
                            <TextBlock Text="CRÉDITO" VerticalAlignment="Center" Margin="5"/>
                        </StackPanel>
                    </Button>
                    <Button Name="Transfer" Foreground="DarkBlue"
                        Width="120" Height="80"
                        Click="btn_Tranfer"
                        FontSize="20"
                        Margin="5"
                        IsEnabled="False"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/Images/sinpe_icon.png" Width="30" Height="30" Margin="5 5 5 0"/>
                            <TextBlock Text="SINPE" VerticalAlignment="Center" Margin="5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
