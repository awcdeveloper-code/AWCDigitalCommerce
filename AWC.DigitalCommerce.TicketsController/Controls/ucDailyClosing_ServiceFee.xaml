<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucDailyClosing_ServiceFee"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" Background="DarkBlue"
             d:DesignHeight="290" d:DesignWidth="420">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="2"
               Content="10% DE SERVICIO"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontSize="30"
               FontWeight="DemiBold"/>
        <Label Grid.Row="2" Grid.Column="2"
               Name="TotalServiceFee"
               Foreground="White"
               VerticalAlignment="Center"
               VerticalContentAlignment="Center"
               HorizontalAlignment="Center"
               FontSize="60"
               Content="0.00"
               FontWeight="DemiBold"/>
        <StackPanel Grid.Row="4" Grid.Column="2"
                    Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Grid.Row="1" Grid.Column="2"
                   Content="FECHA:"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <DatePicker Grid.Row="1" Grid.Column="2"
                        Name="SelectedDay"
                        SelectedDateFormat="Short"
                        VerticalAlignment="Center"
                        Margin="5"
                        FontSize="20"
                        FontWeight="DemiBold"
                        SelectedDateChanged="SelectedDay_SelectedDateChanged"/>
        </StackPanel>
        <Button Grid.Row="5" Grid.Column="2"
                Click="btn_Print"
                Background="DarkBlue"
                Foreground="White"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/printer_icon.png"
                       Width="30" Height="30" Margin="5"/>
                <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
