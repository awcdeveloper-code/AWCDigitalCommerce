<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucTodaySales"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1600" Background="DarkBlue">
    <UserControl.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--SELECT DATE-->
            <Label Grid.Row="1" Grid.Column="1"
               Foreground="Cyan"
               VerticalAlignment="Center"
               FontWeight="DemiBold"
               Content="SELECCIONE FECHA:"/>
            <DatePicker Grid.Row="1" Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Name="SelectedDay"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    FontWeight="DemiBold"
                    SelectedDateChanged="SelectedDay_SelectedDateChanged"/>
            <Label Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="2"
               Name="TotalTodayTickets"
               Foreground="Cyan"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               FontSize="30"
               FontWeight="DemiBold"/>
            <!--DATAGRID-->
            <GroupBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="9"
                  Name="GroupBoxDataGrid"
                  Foreground="Cyan"
                  Header="CUENTAS DEL DIA">
                <DataGrid Name="TodayTickets"
                          Height="725" Width="1060"
                          Margin="5"
                          RowHeight="25"
                          IsReadOnly="True"
                          HorizontalAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Visible" 
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          Background="LightGray"
                          RowBackground="LightCyan"
                          AlternatingRowBackground="Cyan"
                          BorderBrush="Gray" BorderThickness="2"
                          AreRowDetailsFrozen="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns = "False"
                          SelectionChanged="TodayTickets_SelectionChanged"
                          GotFocus="TodayTickets_GotFocus"
                          SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar">
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="40"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA"
                                            Width="130"
                                            Binding="{Binding Path=TicketDate}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                            <DataGridTextColumn Header="TURNO"
                                            Width="80"
                                            Binding="{Binding Path=Shift}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CUENTA"
                                            Width="90"
                                            Binding="{Binding Path=ID}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                            <DataGridTextColumn Header="CLIENTE"
                                                Width="450"
                                                Binding="{Binding Path=CustomerID}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                        <DataGridTextColumn Header="ESTADO"
                                            Width="90"
                                            Binding="{Binding Path=StatusAlpha}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PAGO"
                                            Width="75"
                                            Binding="{Binding Path=PayMethodAlpha}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                            <DataGridTextColumn Header="TOTAL"
                                                Width="95"
                                                Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <Button Grid.Row="4" Grid.Column="1"
                    Name="Print"
                    Click="btn_EmergencyPrint"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/printer_icon.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="ABIERTAS" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="2"
                    Name="PrintClosed"
                    Click="btn_PrintClosed"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/printer_icon.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="3"
                    Name="ElectronicInvoice"
                    Click="btn_ElectronicInvoice"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/printer_icon.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="IVA" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="4"
                    Name="FakeTicket"
                    Click="btn_FakeTicket"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/money_icon.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="MONTO" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="5"
                    Name="eMailTicket"
                    Click="btn_eMailTicket"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/email.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="CORREO" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="6"
                    Name="AbortTicket"
                    Click="btn_AbortTicket"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/delete_sign.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="ANULAR" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="7"
                    Name="ChangeName"
                    Click="btn_ChangeName"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/people.ico" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="NOMBRE" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="8"
                    Name="PrintFoodService"
                    Click="btn_PrintFoodService"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/food-service.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="SERVICIO" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="9"
                    Name="ChangePayMethod"
                    Click="btn_ChangePayMethod"
                    IsEnabled="False"
                    FontSize="15"
                    Margin="2"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Money.ico" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="PAGO" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
