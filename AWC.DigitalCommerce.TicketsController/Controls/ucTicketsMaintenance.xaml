<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucTicketsMaintenance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="890"
             Background="DarkBlue">
    <UserControl.Resources>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontSize="20"
                           FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="cBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkRed"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!--TICKETS LISTBOX-->
        <GroupBox Grid.Row="1" Grid.Column="1" Grid.RowSpan="6"

                  Foreground="Cyan"
                  Name="grpBox_TicketsList"
                  FontSize="15"
                  Margin="5"
                  FontWeight="DemiBold"
                  Header="CUENTAS DISPONIBLES">
            <ListBox Name="lBox_CustomerID"
                     ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                     Height="470"
                     Margin="5"
                     VerticalAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="20"
                     SelectionMode="Single"
                     SelectionChanged="lBox_CustomerID_SelectionChanged" />
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.Column="2"
                  Foreground="Cyan"
                  Name="grpBox_MoveTicket"
                  FontSize="15"
                  Margin="5"
                  FontWeight="DemiBold"
                  IsEnabled="False"
                  Header="REASIGNAR CUENTA A:">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <ComboBox Name="cbox_CustomerID"
                          VerticalAlignment="Center"
                          FontSize="20"
                          Margin="5"
                          FontWeight="DemiBold"
                          ItemsSource="{Binding Tables[0]}"
                          ItemTemplate="{StaticResource cBox_VIP_DataTemplate}"
                          SelectionChanged="cbox_CustomerID_SelectionChanged"/>
                <Button Name="btnReassignTicket"
                        Click="btn_ReassignTicket"
                        IsEnabled="False"
                        Foreground="DarkBlue"
                        FontSize="20"
                        Margin="5"
                        Cursor="Hand"
                        ToolTip="Asignar una cuenta abierta a otro cliente o mesa"
                        FontWeight="DemiBold"
                        Content="REASIGNAR"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="2"
                  Foreground="Cyan"
                  Name="grpBox_InheritTicket"
                  FontSize="15"
                  Margin="5"
                  FontWeight="DemiBold"
                  IsEnabled="False"
                  Header="HEREDAR CUENTA A:">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <ComboBox Name="cbox_CustomerID2"
                          VerticalAlignment="Center"
                          FontSize="20"
                          Margin="5"
                          FontWeight="DemiBold"
                          ItemsSource="{Binding Tables[0]}"
                          ItemTemplate="{StaticResource cBox_VIP_DataTemplate}"
                          SelectionChanged="cbox_CustomerID2_SelectionChanged"/>
                <Button Name="btnInheritTicket"
                        Click="btn_InheritTicket"
                        IsEnabled="False"
                        Foreground="DarkBlue"
                        FontSize="20"
                        Margin="5"
                        Cursor="Hand"
                        ToolTip="Mover el contenido de una cuenta abierta a otra cuenta abierta."
                        FontWeight="DemiBold"
                        Content="HEREDAR"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="3" Grid.Column="2"
                  Foreground="Cyan"
                  Name="grpBox_CancelTicket"
                  FontSize="15"
                  Margin="5"
                  FontWeight="DemiBold"
                  IsEnabled="False"
                  Header="CANCELAR CUENTA">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Label Name="lblTicket2Cancel"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalContentAlignment="Center"
                       Content="CUENTA X ANULAR"
                       FontSize="20"
                       FontWeight="DemiBold"/>
                <Button Name="btnCancelTicket"
                        Click="btn_CancelTicket"
                        IsEnabled="False"
                        Foreground="DarkBlue"
                        FontSize="20"
                        Margin="5"
                        Cursor="Hand"
                        FontWeight="DemiBold"
                        Content="CANCELAR"/>
            </StackPanel>
        </GroupBox>
        <Button Grid.Row="6" Grid.Column="2"
                Name="btnCancel"
                Click="btn_Cancel"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="REINICIAR"/>
        <GroupBox Grid.Row="1" Grid.Column="3" Grid.RowSpan="6"
                  Foreground="Cyan"
                  Name="grpBox_FixTicket"
                  FontSize="15"
                  Margin="5"
                  FontWeight="DemiBold"
                  Header="CORREGIR CUENTA">
            <StackPanel Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <!--LABELS-->
                    <Label Grid.Row="0" Grid.Column="0"
                           Name="lblTicketNumber"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="NRO. CUENTA:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="1" Grid.Column="0"
                           Name="lblTicketDate"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="FECHA:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="2" Grid.Column="0"
                           Name="lblCustomerID"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="COD. CLIENTE:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="3" Grid.Column="0"
                           Name="lblTicketTotal"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="TOTAL:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="4" Grid.Column="0"
                           Name="lblPayments"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="PAYMENTS:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="5" Grid.Column="0"
                           Name="lblServiceFee"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="10% SERVICIO:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="6" Grid.Column="0"
                           Name="lblTicketCash"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="EFECTIVO:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="7" Grid.Column="0"
                           Name="lblTicketCreditCard"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="TARJ CREDITO:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="8" Grid.Column="0"
                           Name="lblTicketTransfer"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="TRANSFER:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="9" Grid.Column="0"
                           Name="lblTicketPayMethod"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="PAYMETHOD:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="10" Grid.Column="0"
                           Name="lblTicketStatus"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="STATUS:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <Label Grid.Row="11" Grid.Column="0"
                           Name="lblSplited"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Content="SPLITED:"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <!--TEXBOXES-->
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Name="txtTicketNum"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"
                             LostFocus="txtTicketNum_LostFocus"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Name="txtTicketDate"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Name="txtTicketCustomerID"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Name="txtTicketTotal"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Name="txtTicketPayments"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Name="txtTicketServiceFee"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Name="txtTicketCash"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Name="txtTicketCreditCard"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="8" Grid.Column="1"
                             Name="txtTicketTransfer"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="9" Grid.Column="1"
                             Name="txtTicketPayMethod"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="10" Grid.Column="1"
                             Name="txtTicketStatus"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <TextBox Grid.Row="11" Grid.Column="1"
                             Name="txtTicketSplited"
                             HorizontalAlignment="Left"
                             IsEnabled="False"
                             Width="100"
                             Margin="5"
                             FontSize="15"
                             Background="Cyan"
                             Foreground="DarkBlue"/>
                    <!--BUTTONS-->
                    <Button Grid.Row="13" Grid.Column="0"
                            Name="TicketCancel"
                            Click="btn_TicketCancel"
                            Foreground="DarkBlue"
                            FontSize="18"
                            Margin="5"
                            Cursor="Hand"
                            FontWeight="DemiBold"
                            Content="CANCELAR"/>
                    <Button Grid.Row="13" Grid.Column="1"
                            Name="TicketUpdate"
                            Click="btn_TicketUpdate"
                            Foreground="DarkBlue"
                            FontSize="18"
                            Margin="5"
                            Cursor="Hand"
                            IsEnabled="False"
                            FontWeight="DemiBold"
                            Content="ACTUALIZAR"/>
                </Grid>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
