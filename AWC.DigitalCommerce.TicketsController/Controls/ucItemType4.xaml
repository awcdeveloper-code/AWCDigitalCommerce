<UserControl x:Class="AWC.DigitalCommerce.TicketsController.ucItemType4"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             xmlns:DV="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
             xmlns:DVC="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1024"
             Background="DarkBlue">
    <Grid>
        <Grid.Resources>
            <local:clsItemTypeCollection x:Key = "clsItemTypeCollection" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="1"
               Foreground="Cyan"
               Content="FECHA:"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="DemiBold"/>
        <DatePicker Grid.Row="1" Grid.Column="2"
                    Name="SelectedDayTab4"
                    SelectedDateFormat="Short"
                    VerticalAlignment="Center"
                    Margin="5"
                    FontSize="20"
                    FontWeight="DemiBold"
                    SelectedDateChanged="SelectedDayTab4_SelectedDateChanged"/>
        <Label Grid.Row="1" Grid.Column="3"
               Foreground="Cyan"
               Content="TIPO:"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="DemiBold"/>
        <ComboBox Grid.Row="1" Grid.Column="4"
                  Name="cbox_ItemTypeTab4"
                  IsEnabled="False"
                  VerticalAlignment="Center"
                  FontSize="20"
                  FontWeight="DemiBold"
                  SelectionChanged="cbox_ItemTypeTab4_SelectionChanged"/>
        <DVC:Chart Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                   Canvas.Top="10" Canvas.Left="10"
                   Name="mcChartTab4"
                   VerticalAlignment="Center"
                   Width="800" Height="450"
                   Background="LightSteelBlue">
            <DVC:Chart.Series>
                <DVC:AreaSeries Name="ItemsListSeriesTab4"
                                Title="CONSUMO"
                                FontSize="10"
                                ItemsSource = "{StaticResource clsItemTypeCollection}"
                                IndependentValueBinding = "{Binding Path = ItemDesc}"
                                DependentValueBinding = "{Binding Path = Qty}">
                    <DVC:AreaSeries.DataPointStyle>
                        <Style TargetType="DVC:AreaDataPoint">
                            <Setter Property="Background" Value="Yellow"/>
                        </Style>
                    </DVC:AreaSeries.DataPointStyle>
                </DVC:AreaSeries>
            </DVC:Chart.Series>
        </DVC:Chart>
    </Grid>
</UserControl>
