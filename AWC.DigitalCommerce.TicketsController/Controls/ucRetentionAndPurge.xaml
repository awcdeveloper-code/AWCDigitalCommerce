<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucRetentionAndPurge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController.Controls"
             mc:Ignorable="d" Background="DarkBlue"
             d:DesignHeight="480" d:DesignWidth="850">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
               Foreground="Cyan"
               FontSize="25" FontWeight="DemiBold"
               Content="Política de Retención y Eliminación"/>

        <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
               Foreground="White"
               FontSize="20"
               FontStyle="Italic"
               TextWrapping="Wrap"
               Text="Una política de retención y eliminación define cuánto tiempo se conservan los datos (retención) y cuándo y cómo se eliminan (eliminación) para equilibrar el cumplimiento normativo, la eficiencia y el riesgo. La política suele establecer reglas para la gestión del ciclo de vida de los datos."/>

        <Label Grid.Column="0" Grid.Row="2"
               Foreground="Cyan"
               FontSize="20"
               Content="Estado de la Política:"/>

        <ComboBox Grid.Column="1" Grid.Row="2"
                  Name="cbBox_PolicyState"
                  Margin="5"
                  Width="160"
                  FontSize="20"
                  HorizontalAlignment="Left">
            <ComboBoxItem Content="Activada" />
            <ComboBoxItem Content="Desactivada" IsSelected="True" />
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="3"
               Foreground="Cyan"
               FontSize="20"
               Content="Período de Retención:"/>

        <ComboBox Grid.Column="1" Grid.Row="3"
                  Name="cbBox_RetentionPeriod"
                  Margin="5"
                  Width="160"
                  FontSize="20"
                  HorizontalAlignment="Left">
            <ComboBoxItem Content="1 año"   IsSelected="True" />
            <ComboBoxItem Content="3 años" />
            <ComboBoxItem Content="5 años" />
            <ComboBoxItem Content="Indefinido"/>
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="4"
               Foreground="Cyan"
               FontSize="20"
               Content="Elementos con estado:"/>

        <ComboBox Grid.Column="1" Grid.Row="4"
                  Name="cbBox_ElementState"
                  Margin="5"
                  Width="160"
                  FontSize="20"
                  HorizontalAlignment="Left">
            <ComboBoxItem Content="Cancelados"   IsSelected="True" />
            <ComboBoxItem Content="Pendientes" />
            <ComboBoxItem Content="Ambos" />
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="5"
               Foreground="Cyan"
               FontSize="20"
               Content="Elementos a Eliminar:"/>

        <CheckBox Grid.Column="1" Grid.Row="5"
                  Name="chkBox_Tickets"
                  Foreground="White"
                  VerticalAlignment="Center"
                  Margin="5"
                  FontSize="15" FontWeight="DemiBold"
                  Content="TIQUETES (INCLUYE TODOS)"/>

        <CheckBox Grid.Column="1" Grid.Row="6"
                  Name="chkBox_Payments"
                  Foreground="White"
                  VerticalAlignment="Center"
                  Margin="5"
                  FontSize="15" FontWeight="DemiBold"
                  Content="PAGOS PARCIALES"/>

        <CheckBox Grid.Column="2" Grid.Row="5"
                  Name="chkBox_Expenses"
                  Foreground="White"
                  VerticalAlignment="Center"
                  Margin="5"
                  FontSize="15" FontWeight="DemiBold"
                  Content="GASTOS INTERNOS"/>

        <CheckBox Grid.Column="2" Grid.Row="6"
                  Name="chkBox_TimeCards"
                  Foreground="White"
                  VerticalAlignment="Center"
                  Margin="5"
                  FontSize="15" FontWeight="DemiBold"
                  Content="REGISTRO DE ACCESOS"/>

        <Button Grid.Column="0" Grid.Row="8"
                Click="btnSave_Click"
                FontSize="20"
                Margin="5"
                Width="180" Height="50"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/Plus_sign.png"
                               Width="25" Height="25" Margin="5"/>
                <TextBlock Text="SALVAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        
    </Grid>
</UserControl>
