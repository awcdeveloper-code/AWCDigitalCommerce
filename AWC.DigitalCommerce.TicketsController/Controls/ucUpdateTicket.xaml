<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucUpdateTicket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1024"
             Background="DarkBlue">
    <UserControl.Resources>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontSize="20"
                           FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="Black"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="75"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="170" />
            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!--LABELCOLUMN-->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    Grid.RowSpan="4"
                    Orientation="Vertical">
            <ListBox Name="lBox_CustomerID"
                     ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                     Height="480"
                     Margin="5"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="20"
                     SelectionMode="Single" SelectionChanged="lBox_CustomerID_SelectionChanged" />
        </StackPanel>
        <!--LABEL COLUMN-->
        <Label Grid.Row="1" Grid.Column="3"
               Name="lblBeverages"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="BEBIDAS:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="2" Grid.Column="3"
               Name="lblLiqours"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="LICORES:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="3" Grid.Column="3"
               Name="lblMeals"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Content="COMIDAS:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <!--LISTBOX COLUMN-->
        <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Vertical">
            <TextBox Name="txtSearchBeer"
                     Width="390"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     FontSize="20"
                     Margin="5"
                     FontWeight="DemiBold"
                     TextChanged="txtSearchBeer_TextChanged" GotFocus="txtSearchBeer_GotFocus" />
            <ListBox Name="lBox_Beer"
                     ItemTemplate="{StaticResource Items_DataTemplate}"
                     Height="120"
                     Margin="5,0,5,5" ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="20"
                     SelectionMode="Single"
                     SelectionChanged="lBox_Beer_SelectionChanged" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Vertical">
            <TextBox Name="txtSearchLiqour"
                     Width="390"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     FontSize="20"
                     Margin="5"
                     FontWeight="DemiBold"
                     TextChanged="txtSearchLiqour_TextChanged"
                     GotFocus="txtSearchLiqour_GotFocus" />
            <ListBox Name="lBox_Liqour"
                     ItemTemplate="{StaticResource Items_DataTemplate}"
                     Height="120"
                     Margin="5,0,5,5"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="20"
                     SelectionMode="Single"
                     SelectionChanged="lBox_Liqour_SelectionChanged" />
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="5" Orientation="Vertical">
            <TextBox Name="txtSearchMeal"
                     Width="390"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     FontSize="20"
                     Margin="5"
                     FontWeight="DemiBold"
                     TextChanged="txtSearchMeal_TextChanged"
                     GotFocus="txtSearchMeal_GotFocus" />
            <ListBox Grid.Row="4" Grid.Column="2"
                     Name="lBox_Meal"
                     ItemsSource="{Binding Tables[0]}"
                     ItemTemplate="{StaticResource Items_DataTemplate}"
                     Height="120"
                     Margin="5,0,5,5"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="20"
                     SelectionMode="Single"
                     SelectionChanged="lBox_Meal_SelectionChanged" />
        </StackPanel>
        <!--TEXTBOX COLUMN-->
        <StackPanel Grid.Row="1" Grid.Column="7"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
            <Label Name="lblBeerQty"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   Content="CANT:"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <TextBox Name="txtQtyBeer"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="50"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     FontSize="25"
                     FontWeight="DemiBold" GotFocus="txtQtyBeer_GotFocus"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="7"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
            <Label Name="lblLiqourQty"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   Content="CANT:"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <TextBox Name="txtQtyLiqour"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="50"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     FontSize="25"
                     FontWeight="DemiBold" GotFocus="txtQtyLiqour_GotFocus"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="7"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
            <Label Name="lblMealsQty"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   Content="CANT:"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <TextBox Name="txtQtyMeal"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="50"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     FontSize="25"
                     FontWeight="DemiBold" GotFocus="txtQtyMeal_GotFocus"/>
        </StackPanel>
        <!--ADD COLUMN-->
        <Button Grid.Row="1" Grid.Column="9"
                Name="AddBeer"
                Click="btn_AddBeer"
                Foreground="DarkBlue"
                VerticalAlignment="Center"
                Height="50"
                FontSize="25"
                Margin="3"
                Padding="3"
                Cursor="Hand"
                FontWeight="DemiBold"
                IsEnabled="False"
                Content="AGREGAR"/>
        <Button Grid.Row="2" Grid.Column="9"
                Name="AddLiqour"
                Click="btn_AddLiqour"
                Foreground="DarkBlue"
                VerticalAlignment="Center"
                Height="50"
                FontSize="25"
                Margin="3"
                Padding="3"
                Cursor="Hand"
                FontWeight="DemiBold"
                IsEnabled="False"
                Content="AGREGAR"/>
        <Button Grid.Row="3" Grid.Column="9"
                Name="AddMeal"
                Click="btn_AddMeal"
                Foreground="DarkBlue"
                VerticalAlignment="Center"
                Height="50"
                FontSize="25"
                Margin="3"
                Padding="3"
                Cursor="Hand"
                FontWeight="DemiBold"
                IsEnabled="False"
                Content="AGREGAR"/>
        <!--CANCEL ORDER-->
        <Button Grid.Row="4" Grid.Column="1"
                Name="CleanOrder"
                Click="btn_CleanOrder"
                IsEnabled="False"
                Foreground="DarkBlue"
                FontSize="25"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="ANULAR"/>
        <!--TAKE ORDER-->
        <Button Grid.Row="4" Grid.Column="5"
                Name="TakeOrder"
                Click="btn_TakeOrder"
                IsEnabled="False"
                Foreground="DarkBlue"
                FontSize="25"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="ACEPTAR ORDEN"/>
        <!--PRINT ORDER-->
        <CheckBox Grid.Row="4" Grid.Column="7" Grid.ColumnSpan="3"
                      Name="PrintOrder"
                      Click="chkBox_PrintOrder"
                      VerticalAlignment="Center"
                      Foreground="Cyan"
                      IsChecked="False"
                      Margin="5"
                      FontSize="15"
                      FontWeight="DemiBold"
                      Content="IMPRIMIR ORDEN"/>
    </Grid>
</UserControl>
