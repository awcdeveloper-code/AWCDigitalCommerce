<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucIncomeCash"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="600" Background="DarkBlue">
    <UserControl.Resources>
        <DataTemplate x:Key="cBox_Meals_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontSize="20"
                           FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <!--GENERAL INCOMES-->
        <GroupBox Grid.Row="0" Grid.Column="0"
                  Grid.RowSpan="6" Grid.ColumnSpan="4"
                  Name="grpGralExpenses"
                  Foreground="Cyan"
                  Margin="5"
                  Header="INGRESO DE EFECTIVO A CAJA">
        </GroupBox>
        <!--LABELS-->
        <Label Grid.Row="2" Grid.Column="1"
               Foreground="Cyan"
               Name="lblDescription"
               VerticalAlignment="Center"
               Content="DESCRIPCIÓN:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="3" Grid.Column="1"
               Foreground="Cyan"
               Name="lblAmount"
               VerticalAlignment="Center"
               Content="MONTO:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <!--TEXTBOX-->
        <TextBox Grid.Row="2" Grid.Column="2"
                 Name="txtIncomeDescription"
                 Background="LightCyan"
                 VerticalAlignment="Center"
                 FontSize="20"
                 Margin="5"
                 FontWeight="DemiBold"/>
        <TextBox Grid.Row="3" Grid.Column="2"
                 Name="txtIncomeAmount"
                 PreviewTextInput="NumberValidationTextBox"
                 Width="110"
                 Margin="5"
                 FontSize="20"
                 Background="LightCyan"
                 HorizontalAlignment="Left"
                 HorizontalContentAlignment="Right"
                 VerticalAlignment="Center"
                 FontWeight="DemiBold"
                 GotFocus="txtIncomeAmount_GotFocus" />
        <!--BUTTON-->
        <Button Grid.Row="4" Grid.Column="2"
                Name="Add"
                Click="btn_AddIncome"
                Foreground="DarkBlue"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsEnabled="False"
                Height="50"
                Width="110"
                FontSize="15"
                Margin="5"
                Padding="5"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/Plus_sign.png" Width="20" Height="20" Margin="3"/>
                <TextBlock Text="AGREGAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
