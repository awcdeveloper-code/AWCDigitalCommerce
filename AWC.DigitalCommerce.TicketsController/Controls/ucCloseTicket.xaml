<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucCloseTicket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100" Background="DarkBlue">
    <UserControl.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontSize="20"
                           FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!--CUSTOMERS LISTBOX-->
        <GroupBox Grid.Row="1" Grid.Column="1"
                  Grid.RowSpan="2" Grid.ColumnSpan="2"
                  Foreground="Cyan"
                  Header="CUENTAS DISPONIBLES">
            <ListBox Name="lBox_CustomerID"
                     ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                     Height="490"
                     Margin="5"
                     VerticalAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="20"
                     SelectionMode="Single"
                     SelectionChanged="lBox_CustomerID_SelectionChanged" />
        </GroupBox>
        <!--TICKET DETAILS-->
        <GroupBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="5"
                  Name="GroupBoxDataGrid"
                  Grid.RowSpan="2"
                  Foreground="Cyan"
                  Header="DETALLE DE LA CUENTA">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblTicketNumber"
                           Content="CUENTA:"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="Cyan"
                           FontSize="30"
                           Margin="5"
                           FontWeight="Bold"/>
                    <Label Name="TicketNumber"
                           Content="000000"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="Cyan"
                           FontSize="30"
                           Margin="5"
                           FontWeight="Bold"/>
                    <Label Grid.Row="4" Grid.Column="6"
                           Name="lblTotal"
                           Content="TOTAL:"
                           VerticalAlignment="Center"
                           HorizontalContentAlignment="Right"
                           Foreground="Cyan"
                           FontSize="30"
                           Margin="5"
                           FontWeight="Bold"/>
                    <Label Grid.Row="4" Grid.Column="7"
                           Name="TotalTicket"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="Cyan"
                           FontSize="30"
                           Margin="5"
                           FontWeight="Bold"/>
                </StackPanel>
                <DataGrid Name="TicketDetail"
                          Height="400" Width="755"
                          Margin="5"
                          RowHeight="40"
                          FontSize="25"
                          IsReadOnly="True"
                          HorizontalAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Visible" 
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          Background="LightGray"
                          RowBackground="LightYellow"
                          AlternatingRowBackground="Cyan"
                          BorderBrush="Gray" BorderThickness="2"
                          AreRowDetailsFrozen="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns = "False" SelectionChanged="TicketDetail_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="365"
                                        Binding="{Binding Path=ItemDesc}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                        <DataGridTextColumn Header="CANT"
                                        Width="100"
                                        Binding="{Binding Path=Qty}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRECIO"
                                        Width="115"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOTAL"
                                        Width="120"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Name="PrintSummary"
                              Click="chkBox_PrintSummary_Click"
                              Foreground="Cyan"
                              IsChecked="False"
                              Margin="5"
                              FontSize="15"
                              FontWeight="DemiBold"
                              Content="AGRUPAR ÍTEMES"/>
                    <CheckBox Name="PrintClosedTicket"
                              Click="chkBox_PrintClosedTicket"
                              Foreground="Cyan"
                              IsChecked="False"
                              Margin="5"
                              FontSize="15"
                              FontWeight="DemiBold"
                              Content="IMPRIMIR CTA CANCELADA"/>
                    <CheckBox Name="ApplyServiceFee"
                              Foreground="Cyan"
                              IsChecked="False"
                              IsEnabled="False"
                              Margin="5"
                              FontSize="15"
                              FontWeight="DemiBold"
                              Content="APLICAR 10% SERVICIO"
                              Click="ApplyServiceFee_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!--CLEAN TICKET-->
        <Button Grid.Row="4" Grid.Column="1"
                Name="Clean"
                Click="btn_CleanTicket"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold"
                Content="IMPRIMIR"/>
        <!--REMOVE ITEM-->
        <Button Grid.Row="4" Grid.Column="2"
                Name="RemoveItem"
                Click="btn_RemoveItem"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold"
                Content="QUITAR"/>
        <!--SPLIT TICKET-->
        <Button Grid.Row="4" Grid.Column="4"
                Name="SplitTicket"
                Click="btn_SplitTicket"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="SEPARAR"/>
        <!--PRINT MEAL-->
        <Button Grid.Row="4" Grid.Column="5"
                Name="PrintMeal"
                Click="btn_PrintMeal"
                IsEnabled="False"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="COMANDA"/>
        <!--DISCOUNT-->
        <Button Grid.Row="4" Grid.Column="6"
                Name="SmallPayment"
                Click="btn_SmallPayment"
                IsEnabled="False"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="ABONAR"/>
        <!--CLOSE TICKET-->
        <Button Grid.Row="4" Grid.Column="7"
                Name="CloseTicket"
                Click="btn_CloseTicket"
                IsEnabled="False"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="PAGAR"/>
        <!--CANCEL TICKET-->
        <Button Grid.Row="4" Grid.Column="8"
                Name="CancelTicket"
                Click="btn_CancelTicket"
                IsEnabled="False"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                Content="ANULAR"/>
    </Grid>
</UserControl>
