<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucSpecials"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="600" Background="DarkBlue">
    <UserControl.Resources>
        <DataTemplate x:Key="cBox_Meals_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontSize="20"
                           FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <!--EMPLOYEES LUNCH-->
        <GroupBox Grid.Row="0" Grid.Column="0"
                  Grid.RowSpan="6" Grid.ColumnSpan="4"
                  Name="grpLunchEmployees"
                  Foreground="Cyan"
                  Margin="5"
                  Header="COMIDAS PARA COLABORADORES"/>
        <Label Grid.Row="1" Grid.Column="1"
               Foreground="Cyan"
               Name="lblLunchDate"
               VerticalAlignment="Center"
               Content="FECHA:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="2" Grid.Column="1"
               Foreground="Cyan"
               Name="lblName"
               VerticalAlignment="Center"
               Content="COLABORADOR:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="3" Grid.Column="1"
               Foreground="Cyan"
               Name="lblLunch"
               VerticalAlignment="Center"
               Content="ALMUERZO:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="4" Grid.Column="1"
               Foreground="Cyan"
               Name="lblQty"
               VerticalAlignment="Center"
               Content="CANTIDAD:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <!--CALENDAR-->
        <DatePicker Grid.Row="1" Grid.Column="2"
                    Name="lunchDatePicker"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Height="30" Width="200"
                    FontSize="20"
                    FontWeight="DemiBold"
                    Margin="5"
                    SelectedDateChanged ="lunchDatePicker_SelectedDateChanged"/>
        <!--TEXTBOX-->
        <TextBox Grid.Row="2" Grid.Column="2"
                 Name="txtEmployeeName"
                 Background="LightCyan"
                 VerticalAlignment="Center"
                 FontSize="20"
                 Margin="5"
                 FontWeight="DemiBold" />
        <!--COMBOBOX-->
        <ComboBox Grid.Row="3" Grid.Column="2"
                  Name="cbox_Meals"
                  VerticalAlignment="Center"
                  FontSize="20"
                  FontWeight="DemiBold"
                  ItemsSource="{Binding Tables[0]}"
                  ItemTemplate="{StaticResource cBox_Meals_DataTemplate}"
                  SelectionChanged="cbox_Meals_SelectionChanged"/>
        <!--TEXTBOX-->
        <TextBox Grid.Row="4" Grid.Column="2"
                 Name="txtQty"
                 PreviewTextInput="NumberValidationTextBox"
                 Width="50"
                 Margin="5"
                 FontSize="20"
                 Background="LightCyan"
                 HorizontalAlignment="Left"
                 HorizontalContentAlignment="Right"
                 VerticalAlignment="Center"
                 FontWeight="DemiBold"
                 GotFocus="txtQty_GotFocus"/>
        <!--BUTTON-->
        <Button Grid.Row="5" Grid.Column="2"
                Name="AddLunch"
                Click="btn_AddLunch"
                Foreground="DarkBlue"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsEnabled="False"
                Height="50"
                Width="110"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/Plus_sign.png"
                       Width="20" Height="20" Margin="3"/>
                <TextBlock Text="AGREGAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
