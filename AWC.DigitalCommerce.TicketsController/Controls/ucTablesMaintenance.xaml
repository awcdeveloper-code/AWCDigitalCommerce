<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucTablesMaintenance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1060"
             Background="DarkBlue">
    <UserControl.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="335" />
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="335"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="335"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition />
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!--LEFT GROUP-->
        <GroupBox Grid.Row="1" Grid.Column="1"
                  Name="grpBoxCustomers"
                  Foreground="Cyan"
                  Header="CLIENTES/MESAS/ASIENTOS"
                  FontSize="15"
                  FontWeight="DemiBold">
            <StackPanel Orientation="Vertical">
                <Label Name="lblCustomerName"
                       Foreground="Cyan"
                       Content="NOMBRE:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <TextBox Name="txtBox_CustomerName"
                         Background="Cyan"
                         Margin="5,0,5,0"
                         FontSize="15"
                         FontWeight="DemiBold"/>
                <Label Name="lblCustomerType"
                       Foreground="Cyan"
                       Content="TIPO:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <ComboBox Name="cbBox_CustomerType"
                          Margin="5,0,5,5"
                          FontSize="15"
                          FontWeight="DemiBold" SelectionChanged="cbBox_CustomerType_SelectionChanged"/>
                <Label Name="lblCreditLimit"
                       Foreground="Cyan"
                       Content="LÍMITE DE CRÉDITO:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <TextBox Name="txtBox_CreditLimit"
                         HorizontalAlignment="Left"
                         Background="Cyan"
                         Margin="5,0,5,5"
                         FontSize="15"
                         Text="0"
                         Width="150"
                         FontWeight="DemiBold"/>
                <CheckBox Name="ApplyServiceFee"
                          VerticalAlignment="Top"
                          Foreground="Cyan"
                          IsChecked="False"
                          Margin="5"
                          FontSize="15"
                          FontWeight="DemiBold"
                          Content=" APLICAR 10% DE SERVICIO"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Image Name="Cancel_Cust"
                           Source="/Images/20.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para cancelar."
                           Cursor="Hand"
                           MouseDown="btnCancel_Cust"/>
                    <Image Name="Add_Cust"
                           Source="/Images/13.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para agregar."
                           Cursor="Hand"
                           MouseDown="btnAdd_Cust"/>
                    <Image Name="Del_Cust"
                           Source="/Images/33.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para borrar."
                           Cursor="Hand"
                           MouseDown="btnDel_Cust"/>
                    <Image Name="Mod_Cust"
                           Source="/Images/38.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para actualizar."
                           Cursor="Hand"
                           MouseDown="btnMod_Cust"/>
                </StackPanel>
                <DataGrid Name="CustCatalog"
                          Height="260" Width="310"
                          Margin="5"
                          RowHeight="25"
                          IsReadOnly="True"
                          HorizontalAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Visible" 
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          Background="LightGray"
                          RowBackground="LightYellow"
                          AlternatingRowBackground="LightCyan"
                          BorderBrush="Gray" BorderThickness="2"
                          AreRowDetailsFrozen="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns = "False"
                          SelectionChanged="CustCatalog_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Width="50"
                                            Binding="{Binding Path=ID}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPCIÓN"
                                            Width="240"
                                            Binding="{Binding Path=CustomerID}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>
        <!--CENTER GROUP-->
        <GroupBox Grid.Row="1" Grid.Column="3"
                  Foreground="Cyan"
                  Name="grpBoxBevLiqMea"
                  Header="BEBIDAS/LICORES/COMIDAS"
                  FontSize="15"
                  FontWeight="DemiBold">
            <StackPanel Orientation="Vertical">
                <Label Name="lblItemName"
                       Foreground="Cyan"
                       Content="NOMBRE:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <TextBox Name="txtBox_ItemName"
                         Background="Cyan"
                         Margin="5,0,5,0"
                         FontSize="15"
                         FontWeight="DemiBold"/>
                <Label Name="lblItemType"
                       Foreground="Cyan"
                       Content="TIPO:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <ComboBox Name="cbBox_ItemType"
                          Margin="5,0,5,5"
                          FontSize="15"
                          FontWeight="DemiBold" SelectionChanged="cbBox_ItemType_SelectionChanged"/>
                <StackPanel Name="LiquorUnit"
                            Orientation="Horizontal"
                            IsEnabled="False">
                    <Label Name="lblItemUnit"
                           Foreground="Cyan"
                           Content="MEDIDA:"
                           Margin="5,5,5,0"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <ComboBox Name="cbBox_ItemUnit"
                              Margin="5"
                              Width="70"
                              FontSize="15"
                              FontWeight="DemiBold" SelectionChanged="cbBox_ItemUnit_SelectionChanged"/>
                    <Label Name="lblItemUnitNum"
                           Foreground="Cyan"
                           Content="UNIDAD:"
                           Margin="5,5,5,0"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <TextBox Name="txtBox_ItemUnitNum"
                             Background="Cyan"
                             Margin="5"
                             Width="50"
                             FontSize="15"
                             FontWeight="DemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblItemPrice"
                           Foreground="Cyan"
                           Content="PRECIO:"
                           Margin="5,5,5,0"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <TextBox Name="txtBox_ItemPrice"
                             Background="Cyan"
                             Margin="5"
                             Width="75"
                             FontSize="15"
                             FontWeight="DemiBold"
                             LostFocus="txtBox_ItemPrice_LostFocus"/>
                    <Label Name="lblItemCost"
                           Foreground="Cyan"
                           Content="COSTO:"
                           Margin="5,5,5,0"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <TextBox Name="txtBox_ItemCost"
                                Background="Cyan"
                                Margin="5"
                                Width="75"
                                FontSize="15"
                                FontWeight="DemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Image Name="Cancel_Item"
                           Source="/Images/20.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para cancelar."
                           Cursor="Hand"
                           MouseDown="btnCancel_Item"/>
                    <Image Name="Add_Item"
                           Source="/Images/13.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para agregar."
                           Cursor="Hand"
                           MouseDown="btnAdd_Item"/>
                    <Image Name="Del_Item"
                           Source="/Images/33.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para borrar."
                           Cursor="Hand"
                           MouseDown="btnDel_Item"/>
                    <Image Name="Mod_Item"
                           Source="/Images/38.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para actualizar."
                           Cursor="Hand"
                           MouseDown="btnMod_Item"/>
                </StackPanel>
                <DataGrid Name="ItemCatalog"
                          Height="280" Width="310"
                          Margin="5"
                          RowHeight="25"
                          IsReadOnly="True"
                          HorizontalAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Visible" 
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          Background="LightGray"
                          RowBackground="LightYellow"
                          AlternatingRowBackground="LightCyan"
                          BorderBrush="Gray" BorderThickness="2"
                          AreRowDetailsFrozen="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns = "False"
                          SelectionChanged="ItemCatalog_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DESCRIPCIÓN"
                                            Width="200"
                                            Binding="{Binding Path=ItemDescription}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRECIO"
                                            Width="80"
                                            Binding="{Binding Path=UnitPrice}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>
        <!--RIGHT GROUP-->
        <GroupBox Grid.Row="1" Grid.Column="5"
                  Foreground="Cyan"
                  Name="grpBoxItemParent"
                  Header="RELACIONES"
                  FontSize="15"
                  FontWeight="DemiBold">
            <StackPanel Orientation="Vertical">
                <Label Name="lblChildItemName"
                       Foreground="Cyan"
                       Content="ITEM ORIGEN:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <ComboBox Name="cbBox_ChildItem"
                          Margin="5,0,5,5"
                          FontSize="15"
                          FontWeight="DemiBold"
                          SelectionChanged="cbBox_ChildItem_SelectionChanged" />
                <Label Name="lblParentItemName"
                       Foreground="Cyan"
                       Content="ITEM DESTINO:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <ComboBox Name="cbBox_ParentItem"
                          Margin="5,0,5,5"
                          FontSize="15"
                          FontWeight="DemiBold"
                          SelectionChanged="cbBox_ParentItem_SelectionChanged"/>
                <Label Name="lblItemParentUnit"
                       Foreground="Cyan"
                       Content="CANT UNIDADES:"
                       Margin="5,5,5,0"
                       FontSize="15"
                       FontWeight="DemiBold"/>
                <TextBox Name="txtBox_ItemParentUnit"
                         Margin="5,0,5,0"
                         FontSize="15"
                         FontWeight="DemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Name="Add_ItemParent"
                           Source="/Images/13.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para agregar."
                           Cursor="Hand"
                           MouseDown="btnAdd_ItemParent"/>
                    <Image Name="Del_ItemParent"
                           Source="/Images/33.ico"
                           Width="40"
                           Height="40"
                           Margin="10"
                           ToolTip="Haga click aqui para borrar."
                           Cursor="Hand"
                           MouseDown="btnDel_ItemParent"/>
                </StackPanel>
                <DataGrid Name="ItemParentCatalog"
                          Height="285" Width="310"
                          Margin="5"
                          RowHeight="25"
                          IsReadOnly="True"
                          HorizontalAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Visible" 
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          Background="LightGray"
                          RowBackground="LightYellow"
                          AlternatingRowBackground="LightCyan"
                          BorderBrush="Gray" BorderThickness="2"
                          AreRowDetailsFrozen="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns = "False"
                          SelectionChanged="ItemParentCatalog_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Width="50"
                                            Binding="{Binding Path=ID}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPCIÓN"
                                            Width="240"
                                            Binding="{Binding Path=ItemDescription}"
                                            HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
