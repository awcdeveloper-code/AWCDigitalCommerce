<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucReportsInventoryMgmt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" Background="DarkBlue"
             d:DesignHeight="550" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="1" Grid.Column="1"
                    Name="WorkArea"
                    Background="Transparent">
            <!--INVOICES-->
            <TabItem Name="tabInvoicesReport">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Name="img1"
                               Height="20" Width="20"
                               Source="/Images/invoice.png" />
                        <TextBlock Text="FACTURAS"
                                   Margin="5"
                                   FontSize="15"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                        <RowDefinition Height="5"/>
                        <RowDefinition />
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <!--HEADER-->
                    <Label Grid.Row="1" Grid.Column="1"
                           Foreground="Cyan"
                           Content="MES:"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <ComboBox Grid.Row="1" Grid.Column="2"
                              Name="cbox_Month"
                              VerticalAlignment="Center"
                              Margin="5"
                              FontSize="15"
                              Foreground="DarkBlue"
                              FontWeight="DemiBold" SelectionChanged="cbox_Month_SelectionChanged" />
                    <!--INVOICE DATAGRID-->
                    <DataGrid Grid.Row="2" Grid.Column="2"
                              Grid.ColumnSpan="4"
                              Name="dgInvoicesList"
                              Width="590"
                              Height="150"
                              FontSize="15"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False" SelectionChanged="dgInvoicesList_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA"
                                                Width="90"
                                                Binding="{Binding InvoiceDate}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="NÚMERO"
                                                Width="75"
                                                Binding="{Binding InvoiceNumber}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                            <DataGridTextColumn Header="NOMBRE DEL PROVEEDOR"
                                                Width="300"
                                                Binding="{Binding ProviderName}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="MONTO"
                                                Width="90"
                                                Binding="{Binding InvoiceAmount, StringFormat=N0}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!--INVOICE DETAIL DATAGRID-->
                    <DataGrid Grid.Row="4" Grid.Column="2"
                              Grid.ColumnSpan="4"
                              Name="dgItemsList"
                              Width="590"
                              Height="150"
                              FontSize="15"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO"
                                                Width="90"
                                                Binding="{Binding ItemID}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO"
                                                Width="375"
                                                Binding="{Binding ItemDescription}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                            <DataGridTextColumn Header="CANT"
                                                Width="90"
                                                Binding="{Binding ItemQty}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!--INVOICES SUMMARY BETWEEN DATES-->
            <TabItem Name="tabInvoicesSummaryByDatesReport">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Name="img6"
                               Height="20" Width="20"
                               Source="/Images/13.ico" />
                        <TextBlock Text="INGRESOS"
                                   Margin="5"
                                   FontSize="15"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <!--HEADER-->
                    <Label Grid.Row="1" Grid.Column="1"
                           Foreground="Cyan"
                           Content="FECHA INICIAL:"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <DatePicker Grid.Row="1" Grid.Column="2"
                                Name="StartDate"
                                SelectedDateFormat="Short"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="DemiBold"
                                SelectedDateChanged="StartDate_SelectedDateChanged"/>
                    <Label Grid.Row="1" Grid.Column="3"
                           Foreground="Cyan"
                           Content="FECHA FINAL:"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <DatePicker Grid.Row="1" Grid.Column="4"
                                Name="EndDate"
                                SelectedDateFormat="Short"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="DemiBold"
                                SelectedDateChanged="EndDate_SelectedDateChanged"/>
                    <!--DATAGRID-->
                    <DataGrid Grid.Row="2" Grid.Column="1"
                              Grid.ColumnSpan="5"
                              Name="dgInvocesSummary"
                              Width="570"
                              Height="330"
                              FontSize="20"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DESCRIPCIÓN"
                                                Width="420"
                                                Binding="{Binding ItemDesc}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CANTIDAD"
                                                Width="110"
                                                Binding="{Binding Qty, StringFormat=N0}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="4" Grid.Column="1"
                            Name="InvocesSummary"
                            Click="btn_InvocesSummary"
                            IsEnabled="False"
                            Background="DarkBlue"
                            Foreground="White"
                            FontSize="20"
                            Margin="5"
                            Cursor="Hand"
                            FontWeight="DemiBold"
                            Content="IMPRIMIR"/>
                </Grid>
            </TabItem>
            <!--NOTES-->
            <TabItem Name="tabNotesReport">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Name="img5"
                               Height="20" Width="20"
                               Source="/Images/AdmTmpl_4.ico" />
                        <TextBlock Text="NOTAS"
                                   Margin="5"
                                   FontSize="15"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                        <RowDefinition Height="5"/>
                        <RowDefinition />
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <!--HEADER-->
                    <Label Grid.Row="1" Grid.Column="1"
                           Foreground="Cyan"
                           Content="MES:"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <ComboBox Grid.Row="1" Grid.Column="2"
                              Name="cbox_Month_Notes"
                              VerticalAlignment="Center"
                              Margin="5"
                              FontSize="15"
                              Foreground="DarkBlue"
                              FontWeight="DemiBold"
                              SelectionChanged="cbox_Month_Notes_SelectionChanged" />
                    <!--NOTES DATAGRID-->
                    <DataGrid Grid.Row="2" Grid.Column="2"
                              Grid.ColumnSpan="4"
                              Name="dgNotesList"
                              Width="590"
                              Height="150"
                              FontSize="15"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False"
                              SelectionChanged="dgNotesList_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA"
                                                Width="90"
                                                Binding="{Binding NoteDate}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="NÚMERO"
                                                Width="75"
                                                Binding="{Binding ID}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TIPO"
                                                Width="55"
                                                Binding="{Binding NoteType}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN"
                                                Width="245"
                                                Binding="{Binding NoteDescription}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="MONTO"
                                                Width="90"
                                                Binding="{Binding NoteAmount, StringFormat=N0}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!--NOTE DETAIL DATAGRID-->
                    <DataGrid Grid.Row="4" Grid.Column="2"
                              Grid.ColumnSpan="4"
                              Name="dgNotesDetail"
                              Width="590"
                              Height="150"
                              FontSize="15"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Width="90"
                                                Binding="{Binding ItemID}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO"
                                                Width="375"
                                                Binding="{Binding ItemDescription}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                            <DataGridTextColumn Header="CANT"
                                                Width="90"
                                                Binding="{Binding ItemQty}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!--DEFECTIVES-->
            <TabItem Name="tabDefectivesItemsReport">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Name="img2"
                               Height="20" Width="20"
                               Source="/Images/damage.png" />
                        <TextBlock Text="DAÑADOS"
                                   Margin="5"
                                   FontSize="15"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <!--HEADER-->
                    <Label Grid.Row="1" Grid.Column="1"
                           Foreground="Cyan"
                           Content="MES:"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <ComboBox Grid.Row="1" Grid.Column="2"
                              Name="cbox_Month_Defectives"
                              VerticalAlignment="Center"
                              Margin="5"
                              FontSize="15"
                              Foreground="DarkBlue"
                              FontWeight="DemiBold" SelectionChanged="cbox_Month_Defectives_SelectionChanged" />
                    <!--INVOICE DATAGRID-->
                    <DataGrid Grid.Row="2" Grid.Column="2"
                              Grid.ColumnSpan="4"
                              Name="dgDefectivesList"
                              Width="670"
                              Height="325"
                              FontSize="15"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA"
                                                Width="90"
                                                Binding="{Binding DeclarationDate}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CÓDIGO"
                                                Width="75"
                                                Binding="{Binding ItemID}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO"
                                                Width="300"
                                                Binding="{Binding ItemDescription}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CANT"
                                                Width="70"
                                                Binding="{Binding ItemQty}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="USUARIO"
                                                Width="100"
                                                Binding="{Binding whoDeclaredName}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!--ITEMS BELOW MINIMUM-->
            <TabItem Name="tabMinimumReport">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Name="img3"
                               Height="20" Width="20"
                               Source="/Images/alert.ico" />
                        <TextBlock Text="DEBAJO DEL MÍNIMO"
                                   Margin="5"
                                   FontSize="15"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <!--MINIMUM ITEM LIST-->
                    <DataGrid Grid.Row="1" Grid.Column="1"
                              Grid.ColumnSpan="3"
                              Name="dgMinimumList"
                              Width="540"
                              Height="300"
                              FontSize="15"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO"
                                                Width="70"
                                                Binding="{Binding ID}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO"
                                                Width="250"
                                                Binding="{Binding ItemDescription}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                            <DataGridTextColumn Header="MÍNIMO"
                                                Width="90"
                                                Binding="{Binding ItemMinimum}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DISPONIBLE"
                                                Width="95"
                                                Binding="{Binding ItemAvailable}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!--PRINT MINIMUM-->
                    <Button Grid.Row="3" Grid.Column="1"
                            Name="Minimum"
                            IsEnabled="False"
                            Click="btn_PrintMinimum"
                            Foreground="DarkBlue"
                            FontSize="15"
                            Margin="5"
                            Cursor="Hand"
                            FontWeight="DemiBold"
                            Content="PRINT"/>
                </Grid>
            </TabItem>
            <!--EXPENSES-->
            <TabItem Name="ExpensesReport">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Name="img4"
                               Height="20" Width="20"
                               Source="/Images/money.ico" />
                        <TextBlock Text="GASTOS GENERALES"
                                   Margin="5"
                                   FontSize="15"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <!--EXPENSES LIST-->
                    <DataGrid Grid.Row="1" Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Name="dgExpenses"
                              Width="515"
                              Height="300"
                              FontSize="15"
                              Padding="5"
                              HorizontalAlignment="Left"
                              FontWeight="DemiBold"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              VerticalScrollBarVisibility="Visible"
                              Background="LightGray"
                              RowBackground="LightCyan"
                              AlternatingRowBackground="Cyan"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns = "False"
                              AutoGenerateColumns="False"
                              SelectionChanged="dgExpenses_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Width="50"
                                                Binding="{Binding ID}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="FECHA"
                                                Width="90"
                                                Binding="{Binding ExpenseDate}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN DEL GASTO"
                                                Width="260"
                                                Binding="{Binding ExpenseDescription}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                            <DataGridTextColumn Header="MONTO"
                                                Width="80"
                                                Binding="{Binding ExpenseAmount, StringFormat=N0}"
                                                HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Grid.Column="1"
                            Name="btnDelete"
                            Click="btn_Delete"
                            FontSize="20"
                            Margin="5"
                            Cursor="Hand"
                            IsEnabled="False"
                            FontWeight="DemiBold"
                            Content="BORRAR"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
