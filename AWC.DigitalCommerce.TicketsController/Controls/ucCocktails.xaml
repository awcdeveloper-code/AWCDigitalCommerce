<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucCocktails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController.Controls"
             mc:Ignorable="d" Background="DarkBlue" Height="700" Width="1200">
    <UserControl.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="40"/>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <ListBox Grid.Row="1" Grid.Column="1"
                     Name="lBox_CocktailRecipes"
                     BorderBrush="Cyan"
                     BorderThickness="3"
                     Background="LightCyan"
                     FontSize="25"
                     Margin="5"
                     FontWeight="DemiBold"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     SelectionChanged="lBox_CocktailRecipes_SelectionChanged">
            </ListBox>
            <TextBox Grid.Column="2" Grid.Row="1"
                     Name="txtCocktailRecipeContent"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     BorderBrush="Cyan"
                     BorderThickness="3"
                     Background="LightCyan"
                     FontSize="25"
                     Margin="5"/>
        </Grid>
    </Border>
</UserControl>
