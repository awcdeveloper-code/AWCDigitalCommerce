<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucOldTickets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1300" Background="DarkBlue">
    <UserControl.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1" Orientation="Horizontal">
                <Image Source="{Binding ImagePath}"
                       Width="25" Height="25"
                       Margin="0,0,5,0"/>
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="580"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--DEFAULT CUSTOMERS-->
            <GroupBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                  Foreground="Cyan"
                  Name="grpDefaultCustomers"
                  Header="CLIENTES MOROSOS">
                <StackPanel Orientation="Vertical">
                    <ListBox Name="lBox_CustomerID"
                             Height="540"
                             Margin="5"
                             VerticalAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             FontSize="20"
                             SelectionMode="Single"
                             ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                             SelectionChanged="lBox_CustomerID_SelectionChanged"
                             GotFocus="lBox_CustomerID_GotFocus">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </StackPanel>
            </GroupBox>
            <!--TICKETS OPENS-->
            <GroupBox Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="4"
                  Foreground="Cyan"
                  Name="grpOpenTickets"
                  Header="CUENTAS PENDIENTES DE PAGO">
                <StackPanel Orientation="Vertical">
                    <DataGrid Name="OldOpenTickets"
                          Height="540" Width="690"
                          RowHeight="35"
                          FontSize="25"
                          IsReadOnly="True"
                          IsEnabled="False"
                          HorizontalAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Visible" 
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          Background="LightGray"
                          RowBackground="White"
                          AlternatingRowBackground="Cyan"
                          BorderBrush="Gray" BorderThickness="2"
                          AreRowDetailsFrozen="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns = "False"
                          SelectionChanged="OldOpenTickets_SelectionChanged" GotFocus="OldOpenTickets_GotFocus">
                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA"
                                        Width="130"
                                        Binding="{Binding Path=TicketDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CTA"
                                        Width="90"
                                        Binding="{Binding Path=ID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CLIENTE"
                                        Width="310"
                                        Binding="{Binding Path=CustomerAKA}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                            <DataGridTextColumn Header="TOTAL"
                                        Width="110"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
            <!--PRINT BUTTON-->
            <Button Grid.Row="2" Grid.Column="1"
                Name="PrintTicket"
                Click="btn_PrintTicket"
                FontSize="15"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/printer_icon.png" Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!--ABORT BUTTON-->
            <Button Grid.Row="2" Grid.Column="2"
                Name="AbortTicket"
                Click="btn_AbortTicket"
                FontSize="15"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png" Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="ANULAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!--REVIEW BUTTON-->
            <Button Grid.Row="2" Grid.Column="3"
                Name="ReviewTicket"
                Click="btn_ReviewTicket"
                FontSize="15"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/invoice.png" Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="REVISAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!--PAYMENT BUTTON-->
            <Button Grid.Row="2" Grid.Column="5"
                Name="SmallPaymentTicket"
                Click="btn_SmallPaymentTicket"
                FontSize="15"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/Money.ico" Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="ABONAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!--REASSIGN BUTTON-->
            <Button Grid.Row="2" Grid.Column="6"
                Name="AssignTicket"
                Click="btn_AssignTicket"
                FontSize="15"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/shiftchange.png" Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="REASIGNAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!--PAY BUTTON-->
            <Button Grid.Row="2" Grid.Column="7"
                Name="PayTicket"
                Click="btn_PayTicket"
                FontSize="15"
                Margin="5"
                IsEnabled="False"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/money_icon.png" Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="PAGAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!--TOTAL LABEL-->
            <Label Grid.Row="2" Grid.Column="8" Grid.ColumnSpan="2"
               Name="TotalOldTickets"
               Foreground="Cyan"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               FontSize="25"
               Margin="5"
               FontWeight="DemiBold"/>
            <!--PRINT CLOSED TICKET-->
            <CheckBox Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="2"
                  Name="PrintClosedTicket"
                  Click="chkBox_PrintClosedTicket"
                  Foreground="Cyan"
                  IsChecked="True"
                  Margin="10"
                  FontSize="15"
                  FontWeight="DemiBold"
                  Content="IMPRIMIR CUENTA CANCELADA"/>
            <!--APPLY SERVICE FEE-->
            <CheckBox Grid.Row="3" Grid.Column="7" Grid.ColumnSpan="2"
                  Name="ApplyServiceFee"
                  Click="chkBox_ApplyServiceFee"
                  Foreground="Cyan"
                  Margin="10"
                  FontSize="15"
                  FontWeight="DemiBold"
                  Content="APLICAR 10% SERVICIO"/>
        </Grid>
    </Border>
</UserControl>
