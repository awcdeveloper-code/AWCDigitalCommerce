<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucInternalOrders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController.Controls"
             mc:Ignorable="d" d:DesignHeight="580" d:DesignWidth="620"
             Background="DarkBlue">
    <UserControl.Resources>
        <Style x:Key="CenterGridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
        </Style>
        <DataTemplate x:Key="cBox_Providers_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ProviderName}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="cBox_ItemDescription_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="50"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--LABELS-->
        <Label Grid.Row="1" Grid.Column="0"
               Foreground="Cyan"
               Margin="5"
               VerticalAlignment="Center"
               HorizontalContentAlignment="Right"
               Content="PROVEEDOR:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="2" Grid.Column="0"
               Foreground="Cyan"
               Margin="5"
               VerticalAlignment="Center"
               HorizontalContentAlignment="Right"
               Content="EMAIL:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="3" Grid.Column="0"
               Foreground="Cyan"
               Margin="5"
               VerticalAlignment="Center"
               HorizontalContentAlignment="Right"
               Content="PRODUCTO:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <Label Grid.Row="4" Grid.Column="0"
               Foreground="Cyan"
               Margin="5"
               VerticalAlignment="Center"
               HorizontalContentAlignment="Right"
               Content="CANTIDAD:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <!--INPUT-->
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                 Name="txtOrderDescription"
                 Background="LightCyan"
                 VerticalAlignment="Center"
                 FontSize="30"
                 FontWeight="DemiBold"
                 TextChanged="txtOrderDescription_TextChanged" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                 Name="txtProviderEmail"
                 Background="LightCyan"
                 VerticalAlignment="Center"
                 FontSize="30"
                 FontWeight="DemiBold"
                 TextChanged="txtProviderEmail_TextChanged" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                 Name="txtProductDescription"
                 Background="LightCyan"
                 VerticalAlignment="Center"
                 FontSize="30"
                 FontWeight="DemiBold"
                 TextChanged="txtProductDescription_TextChanged" />
        <TextBox Grid.Row="4" Grid.Column="1"
                 Name="txtProductQty"
                 Width="70"
                 Background="LightCyan"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 FontSize="30"
                 FontWeight="DemiBold"
                 TextChanged="txtProductQty_TextChanged" />
        <Button Grid.Row="4" Grid.Column="3"
                Name="btnAddProduct"
                Click="btn_AddProduct"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/Plus_sign.png" Width="20" Height="20" Margin="3"/>
                <TextBlock Text="AGREGAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <!--DATAGRID-->
        <DataGrid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                  Name="dgItemsList"
                  Width="450"
                  Height="290"
                  FontSize="20"
                  Padding="5"
                  HorizontalAlignment="Left"
                  FontWeight="DemiBold"
                  IsReadOnly="True"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible"
                  Background="LightGray"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False"
                  AutoGenerateColumns="False"
                  SelectionChanged="dgItemsList_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO"
                                    Width="335"
                                    Binding="{Binding ItemDescription}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                <DataGridTextColumn Header="CANT"
                                    Width="80"
                                    Binding="{Binding ItemQty}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!--BUTTONS-->
        <Button Grid.Row="6" Grid.Column="1"
                Name="btnDeleteProduct"
                Click="btn_DeleteProduct"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Padding="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/delete_sign.png" Width="20" Height="20" Margin="3"/>
                <TextBlock Text="BORRAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="6" Grid.Column="2"
                Name="btnPrintOrder"
                Click="btn_PrintOrder"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Padding="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/printer_icon.png" Width="20" Height="20" Margin="3"/>
                <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="6" Grid.Column="3"
                Name="btnSaveOrder"
                Click="btn_SaveOrder"
                Foreground="DarkBlue"
                FontSize="20"
                Margin="5"
                Padding="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/email.png" Width="30" Height="30" Margin="3"/>
                <TextBlock Text="ENVIAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
