<UserControl x:Class="AWC.DigitalCommerce.TicketsController.Controls.ucNewTicket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="1050" Background="DarkBlue">
    <UserControl.Resources>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="lBox_TablesSeats_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="165"/>
                <RowDefinition Height="165"/>
                <RowDefinition Height="165"/>
                <RowDefinition Height="100" />
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!-- VIP  -->
            <GroupBox Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                      Name="VIPGroupBox"
                      Foreground="Cyan"
                      Header="Cliente Frecuente">
                <StackPanel Orientation="Vertical">
                    <TextBox Name="txtSearchVIP"
                             Background="Cyan"
                             Width="278"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             FontSize="20"
                             Margin="5"
                             FontWeight="DemiBold"
                             TextChanged="txtSearchVIP_TextChanged"
                             GotFocus="txtSearchVIP_GotFocus" />
                    <ListBox Name="lBox_VIP"
                             Height="260"
                             Margin="5"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             FontSize="20"
                             ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                             SelectionChanged="lBox_VIP_SelectionChanged">
                    </ListBox>
                </StackPanel>
            </GroupBox>
            <!-- Tables and Seats  -->
            <GroupBox Grid.Row="3" Grid.Column="1"
                      Name="TablesSeatsGroupBox"
                      Foreground="Cyan"
                      Header="Mesas y Asientos">
                <ListBox Name="lBox_TablesSeats"
                         ItemsSource="{Binding Tables[0]}"
                         ItemTemplate="{StaticResource lBox_TablesSeats_DataTemplate}"
                         Margin="5"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         FontSize="20"
                         SelectionChanged="lBox_TablesSeats_SelectionChanged" />
            </GroupBox>
            <!-- New Customer  -->
            <GroupBox Grid.Row="4" Grid.Column="1"
                      Name="NewCustomerGroupBox"
                      Foreground="Cyan"
                      Header="Cliente Nuevo">
                <StackPanel Orientation="Vertical">
                    <TextBox Name="txtUnkowCust"
                             Height="30"
                             Margin="5"
                             FontSize="20"
                             FontWeight="DemiBold"
                             TextChanged="txtUnkowCust_TextChanged"
                             GotFocus="txtUnkowCust_GotFocus" KeyUp="txtUnkowCust_KeyUp"/>
                    <CheckBox Name="ApplyServiceFee"
                              VerticalAlignment="Top"
                              Foreground="Cyan"
                              IsChecked="False"
                              Margin="5"
                              FontSize="15"
                              FontWeight="DemiBold"
                              Content=" APLICAR 10% DE SERVICIO"/>
                </StackPanel>
            </GroupBox>
            <!--LABEL COLUMN-->
            <Label Grid.Row="1" Grid.Column="3"
                   Name="lblBeerSoda"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   Content="Cervezas:"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="2" Grid.Column="3"
                   Name="lblLiqour"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   Content="Licores:"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="3" Grid.Column="3"
                   Name="lblMeal"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   Content="Comidas:"
                   FontSize="20"
                   FontWeight="DemiBold"/>
            <!--LISTBOX COLUMN-->
            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Vertical">
                <TextBox Name="txtSearchBeer"
                             Width="390"
                             Background="Cyan"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             FontSize="20"
                             Margin="5"
                             FontWeight="DemiBold"
                             TextChanged="txtSearchBeer_TextChanged" GotFocus="txtSearchBeer_GotFocus" />
                <ListBox Name="lBox_Beer"
                             ItemTemplate="{StaticResource Items_DataTemplate}"
                             Height="120"
                             Margin="5,0,5,5" ScrollViewer.VerticalScrollBarVisibility="Visible"
                             FontSize="20"
                             SelectionMode="Single"
                             SelectionChanged="lBox_Beer_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Vertical">
                <TextBox Name="txtSearchLiqour"
                         Width="390"
                         Background="Cyan"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         FontSize="20"
                         Margin="5"
                         FontWeight="DemiBold"
                         TextChanged="txtSearchLiqour_TextChanged"
                         GotFocus="txtSearchLiqour_GotFocus" />
                <ListBox Name="lBox_Liqour"
                         ItemTemplate="{StaticResource Items_DataTemplate}"
                         Height="120"
                         Margin="5,0,5,5"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         FontSize="20"
                         SelectionMode="Single"
                         SelectionChanged="lBox_Liqour_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Vertical">
                <TextBox Name="txtSearchMeal"
                         Width="390"
                         Background="Cyan"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         FontSize="20"
                         Margin="5"
                         FontWeight="DemiBold"
                         TextChanged="txtSearchMeal_TextChanged"
                         GotFocus="txtSearchMeal_GotFocus" />
                <ListBox Grid.Row="3" Grid.Column="4"
                         Name="lBox_Meal"
                         ItemsSource="{Binding Tables[0]}"
                         ItemTemplate="{StaticResource Items_DataTemplate}"
                         Height="120"
                         Margin="5,0,5,5"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         FontSize="20"
                         SelectionMode="Single"
                         SelectionChanged="lBox_Meal_SelectionChanged" />
            </StackPanel>
            <!--TEXTBOX COLUMN-->
            <TextBox Grid.Row="1" Grid.Column="6"
                     Name="txtQtyBeer"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="50"
                     FontSize="25"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     FontWeight="DemiBold" GotFocus="txtQtyBeer_GotFocus"/>
            <TextBox Grid.Row="2" Grid.Column="6"
                     Name="txtQtyLiqour"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="50"
                     FontSize="25"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     FontWeight="DemiBold" GotFocus="txtQtyLiqour_GotFocus"/>
            <TextBox Grid.Row="3" Grid.Column="6"
                     Name="txtQtyMeal"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="50"
                     FontSize="25"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     FontWeight="DemiBold" GotFocus="txtQtyMeal_GotFocus"/>
            <!--ADD COLUMN-->
            <Button Grid.Row="1" Grid.Column="7"
                    Name="AddBeer"
                    Click="btn_AddBeer"
                    Foreground="DarkBlue"
                    VerticalAlignment="Center"
                    Height="50"
                    FontSize="25"
                    Margin="3"
                    Padding="3"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    IsEnabled="False"
                    Content="AGREGAR"/>
            <Button Grid.Row="2" Grid.Column="7"
                    Name="AddLiqour"
                    Click="btn_AddLiqour"
                    Foreground="DarkBlue"
                    VerticalAlignment="Center"
                    Height="50"
                    FontSize="25"
                    Margin="3"
                    Padding="3"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    IsEnabled="False"
                    Content="AGREGAR"/>
            <Button Grid.Row="3" Grid.Column="7"
                    Name="AddMeal"
                    Click="btn_AddMeal"
                    Foreground="DarkBlue"
                    VerticalAlignment="Center"
                    Height="50"
                    FontSize="25"
                    Margin="3"
                    Padding="3"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    IsEnabled="False"
                    Content="AGREGAR"/>
            <!--CANCEL ORDER-->
            <Button Grid.Row="4" Grid.Column="3"
                    Name="Clean"
                    Click="btn_CleanOrder"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    Content="BORRE"/>
            <!--TAKE ORDER-->
            <Button Grid.Row="4" Grid.Column="4"
                    Name="TakeOrder"
                    Click="btn_TakeOrder"
                    IsEnabled="False"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    Content="ACEPTAR ORDEN"/>
            <!--PRINT ORDER-->
            <CheckBox Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="2"
                      Name="PrintOrder"
                      Click="chkBox_PrintOrder"
                      VerticalAlignment="Center"
                      Foreground="Cyan"
                      IsChecked="False"
                      Margin="5"
                      FontSize="15"
                      FontWeight="DemiBold"
                      Content="IMPRIMIR ORDEN"/>
        </Grid>
    </Grid>
</UserControl>
