<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfChangeCustName"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        Background="Cyan" Height="230" Width="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
               Foreground="DarkBlue"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="30"
               FontWeight="DemiBold"
               Content="INGRESE NUEVO NOMBRE:"/>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                     Name="txtNewName"
                     FontSize="30"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Left"
                     FontWeight="DemiBold"
                     TextChanged="txtNewName_TextChanged" />
            <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                      Name="chkBox_RestVoucher"
                      Foreground="DarkBlue"
                      VerticalAlignment="Center"
                      IsChecked="False"
                      FontSize="15"
                      FontWeight="DemiBold"
                      Content="VOUCHER DE SERVICIO DE RESTAURANTE"/>
            <Button Grid.Row="5" Grid.Column="1"
                    Click="btn_Cancel"
                    FontSize="20"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="5" Grid.Column="3"
                    Name="btnOK"
                    Click="btn_OK"
                    IsEnabled="False"
                    FontSize="20"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="OK" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
