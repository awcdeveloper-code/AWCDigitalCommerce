<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSelectCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="500" Width="470" ResizeMode="NoResize"
        Background="DarkBlue" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
               Foreground="Cyan"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Content="SELECCIONE PREFACTURA"
               FontSize="25"
               FontWeight="DemiBold"/>
        <ListBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                 Name="lBox_Customers"
                 Margin="5"
                 BorderBrush="Cyan" BorderThickness="3"
                 FontSize="25"
                 FontWeight="DemiBold"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 SelectionChanged="lBox_Customers_SelectionChanged">
            <ListBox.Resources>
                <Style TargetType="ScrollBar">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="40"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Resources>
        </ListBox>
        <Button Grid.Row="4" Grid.Column="1"
                Click="btn_Cancel"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="4" Grid.Column="2"
                Name="Delete"
                Click="btn_Delete"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/clean.png"
                           Width="25" Height="25" Margin="5"/>
                <TextBlock Text="BORRAR" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="4" Grid.Column="3"
                Name="Continue"
                Click="btn_SelectCustomer"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold"
                IsEnabled="False">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                <TextBlock Text="OK" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
