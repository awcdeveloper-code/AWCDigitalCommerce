<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfDelinquency"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="550" Width="845" Background="Cyan"
        WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--LABELS-->
            <Label Grid.Row="1" Grid.Column="1"
               Name="Month"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="DemiBold"
               Content="REVISAR MES:"/>
            <Label Grid.Row="1" Grid.Column="3"
               Name="Title"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Foreground="DarkBlue"
               FontSize="20"
               FontWeight="DemiBold"
               Content="MOROSIDAD DE CLIENTES FRECUENTES"/>
            <!--COMBOBOX-->
            <ComboBox Grid.Row="1" Grid.Column="2"
                  Name="cbox_Month"
                  VerticalAlignment="Center"
                  FontSize="20"
                  FontWeight="DemiBold"
                  SelectionChanged="cbox_Month_SelectionChanged" />
            <!--DATAGRID-->
            <DataGrid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                  Name="dgDelincuency"
                  Width="810" Height="410" Padding="5"
                  FontSize="20" FontWeight="DemiBold"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible"
                  IsReadOnly="True"
                  Background="LightGray"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False"
                  AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                    Width="75"
                                    Binding="{Binding ID}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="NOMBRE DEL CLIENTE"
                                    Width="300"
                                    Binding="{Binding CustomerName}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="1 - 8d"
                                    Width="100"
                                    Binding="{Binding sum_1_8_days, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="9 - 15d"
                                    Width="100"
                                    Binding="{Binding sum_9_15_days, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="16 - 30d"
                                    Width="100"
                                    Binding="{Binding sum_16_30_days, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="> 30d"
                                    Width="100"
                                    Binding="{Binding sum_31_days, StringFormat=N0}"
                                    HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!--BUTTONS-->
            <Button Grid.Row="4" Grid.Column="1"
                Name="Cancel"
                Click="btn_Cancel"
                Background="Cyan"
                FontSize="18"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="2"
                Name="Print"
                Click="btn_Print"
                Background="Cyan"
                FontSize="18"
                Margin="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/printer_icon.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
