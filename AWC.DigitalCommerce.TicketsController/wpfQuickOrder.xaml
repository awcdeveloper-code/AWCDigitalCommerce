<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfQuickOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="700" Width="350"  Background="Orange"
        WindowState="Normal" WindowStyle="None" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True">
    <Window.Resources>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Red" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--PRODUCT SELECTION-->
            <Label Grid.Row="1" Grid.Column="1"
               Foreground="DarkBlue"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Content="VENTA RÁPIDA"
               FontSize="30"
               FontWeight="DemiBold"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                 Name="txtSearchProduct"
                 Background="Cyan"
                 VerticalAlignment="Center"
                 Margin="5"
                 FontSize="20"
                 FontWeight="DemiBold"
                 TextChanged="txtSearchProduct_TextChanged"
                 GotFocus="txtSearchProduct_GotFocus" />
            <ListBox Grid.Row="4" Grid.Column="1"
                 Name="lBox_Products"
                 ItemTemplate="{StaticResource Items_DataTemplate}"
                 VerticalAlignment="Stretch"
                 Margin="5,0,5,5" ScrollViewer.VerticalScrollBarVisibility="Visible"
                 FontSize="20"
                 SelectionMode="Single"
                 SelectionChanged="lBox_Products_SelectionChanged" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                <Label Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   Content="CANTIDAD:"
                   FontSize="15"
                   FontWeight="DemiBold"/>
                <TextBox Name="txtQtyProduct"
                     PreviewTextInput="NumberValidationTextBox"
                     Width="30"
                     FontSize="15"
                     Margin="5"
                     IsEnabled="False"
                     FontWeight="DemiBold"
                     Background="Cyan"
                     Foreground="DarkBlue"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     GotFocus="txtQtyProduct_GotFocus"/>
                <Button Name="AddProduct"
                    Click="btn_AddProduct"
                    Foreground="DarkBlue"
                    VerticalAlignment="Center"
                    Margin="5"
                    Padding="5"
                    FontSize="15"
                    FontWeight="DemiBold"
                    Cursor="Hand"
                    IsEnabled="False"
                    Content="  AGREGAR  "/>
            </StackPanel>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical">
                <DataGrid Name="TicketDetail"
                          Height="150" Margin="5" RowHeight="20"
                          IsReadOnly="True"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" 
                          VerticalAlignment="Top"
                          GridLinesVisibility="Vertical"
                          HeadersVisibility="All"
                          Background="LightCyan"
                          RowBackground="Cyan"
                          AlternatingRowBackground="LightYellow"
                          BorderBrush="DarkBlue"
                          AreRowDetailsFrozen="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns = "False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="140"
                                        Binding="{Binding Path=ItemDesc}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                        <DataGridTextColumn Header="CAN"
                                        Width="40"
                                        Binding="{Binding Path=Qty}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRECIO"
                                        Width="50"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOTAL"
                                        Width="50"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <CheckBox Name="PrintClosedTicket"
                          Click="chkBox_PrintClosedTicket"
                          Foreground="DarkBlue"
                          IsChecked="True"
                          Margin="5"
                          FontSize="15"
                          FontWeight="DemiBold"
                          Content="IMPRIMIR CUENTA CANCELADA"/>
            </StackPanel>
            <StackPanel Grid.Row="7" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                <Button Click="btn_Close"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="5,5,35,5"
                    Cursor="Hand"
                    FontWeight="DemiBold"
                    Content="  CANCELAR  "/>
                <Button Name="Payment"
                    Click="btn_Payment"
                    Foreground="DarkBlue"
                    FontSize="20"
                    Margin="35,5,5,5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold"
                    Content="  PAGAR  "/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
