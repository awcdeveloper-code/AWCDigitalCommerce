<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfCustomerOpenTickets2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="520" Width="500"
        ResizeMode="NoResize" Background="DarkBlue"
        WindowStyle="None" WindowStartupLocation="CenterScreen" >
    <Window.Resources>
        <Style x:Key = "CenterGridHeaderStyle"
               TargetType = "DataGridColumnHeader">
            <Setter Property = "HorizontalContentAlignment" Value="Center"/>
            <Setter Property = "FontSize" Value="25"/>
            <Setter Property = "FontWeight" Value="DemiBold"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="270"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--HEADER LABEL-->
            <Label Grid.Row="1" Grid.Column="1"
                   Foreground="Cyan"
                   Content="ATENCIÓN: CUENTAS PENDIENTES"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   FontSize="20"
                   FontWeight="Bold"/>
            <Label Grid.Row="2" Grid.Column="1"
                   Foreground="Cyan"
                   Name="lblCustomerName"
                   Content="NOMBRE DE CLIENTE"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   FontSize="30"
                   FontWeight="Bold"
               />
            <DataGrid Grid.Row="4" Grid.Column="1"
                  Name="OldOpenTickets"
                  Height="255" Width="425"
                  Margin="5"
                  RowHeight="35"
                  IsReadOnly="True"
                  HorizontalAlignment="Center"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible" 
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="LightGray"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  BorderBrush="DarkBlue" BorderThickness="1"
                  AreRowDetailsFrozen="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False"
                  SelectionChanged="OldOpenTickets_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA"
                                        Width="140"
                                        Binding="{Binding Path = TicketDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value = "Center" />
                                <Setter Property="FontSize" Value = "25" />
                                <Setter Property = "FontWeight" Value="DemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CUENTA"
                                        Width="130"
                                        Binding="{Binding Path = ID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value = "Center" />
                                <Setter Property="FontSize" Value = "25" />
                                <Setter Property = "FontWeight" Value="DemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="MONTO"
                                        Width="130"
                                        Binding="{Binding Path = TotalPrice, StringFormat = N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value = "Right" />
                                <Setter Property="FontSize" Value = "25" />
                                <Setter Property = "FontWeight" Value="DemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Label Grid.Row="5" Grid.Column="1"
               Name="lbl_TotalOpenTickets"
                   Foreground="Cyan"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   FontSize="35"
                   FontWeight="Bold"/>
            <!--BUTTONS-->
            <StackPanel Grid.Row="7" Grid.Column="1"
                    Orientation="Horizontal">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                        Click="btn_Cancel"
                        Margin="5"
                        FontSize="20"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                            <TextBlock Text="CANCELAR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                        Click="btn_Continue"
                        Margin="5"
                        FontSize="20"
                        Cursor="Hand"
                        FontWeight="DemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/next.png"
                           Width="25" Height="25" Margin="5"/>
                            <TextBlock Text="CONTINUE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
