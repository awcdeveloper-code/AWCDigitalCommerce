<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfChartExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        xmlns:lc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Análisis de Ventas" Height="450" Width="625" WindowStartupLocation="CenterScreen">
    <Grid>
        <lc:CartesianChart Name="MyChart">
            <lc:CartesianChart.Series>
                <lc:LineSeries Values="{Binding Values}" Title="Análisis de Ventas" />
                <!--
                <lc:ColumnSeries Values="{Binding Values}" Title="Análisis de Ventas" />
                -->
            </lc:CartesianChart.Series>
            <lc:CartesianChart.AxisX>
                <lc:Axis Title="Meses" Labels="{Binding Labels}" />
            </lc:CartesianChart.AxisX>
            <lc:CartesianChart.AxisY>
                <lc:Axis Title="ventas" />
            </lc:CartesianChart.AxisY>
        </lc:CartesianChart>
    </Grid>
</Window>
