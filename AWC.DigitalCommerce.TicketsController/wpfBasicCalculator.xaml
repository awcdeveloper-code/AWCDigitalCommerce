<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfBasicCalculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Title="Basic Calculator" Height="450" Width="350"
        Background="Cyan">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!--DISPLAY RESULT-->
        <TextBox Grid.Row="1" Grid.Column="1"
                 Grid.ColumnSpan="4"
                 Name="txtResult"
                 Text="0"
                 Margin="5"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Center"
                 FontSize="40"
                 IsEnabled="False"
                 FontWeight="DemiBold" />
        <!--BUTTONS 1 2 3 * -->
        <Button Grid.Row="2" Grid.Column="1"
                Name="btn1"
                Click="btn1_Click"
                Content="1"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="2" Grid.Column="2"
                Name="btn2"
                Click="btn2_Click"
                Content="2"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="2" Grid.Column="3"
                Name="btn3"
                Click="btn3_Click"
                Content="3"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="2" Grid.Column="4"
                Name="btn16"
                Click="btn16_Click"
                Content="*"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <!--BUTTONS 4 5 6 / -->
        <Button Grid.Row="3" Grid.Column="1"
                Name="btn4"
                Click="btn4_Click"
                Content="4"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="3" Grid.Column="2"
                Name="btn5"
                Click="btn5_Click"
                Content="5"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="3" Grid.Column="3"
                Name="btn6"
                Click="btn6_Click"
                Content="6"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="3" Grid.Column="4"
                Name="btn17"
                Click="btn17_Click"
                Content="/"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <!--BUTTONS 7 8 9 + -->
        <Button Grid.Row="4" Grid.Column="1"
                Name="btn7"
                Click="btn7_Click"
                Content="7"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="4" Grid.Column="2"
                Name="btn8"
                Click="btn8_Click"
                Content="8"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="4" Grid.Column="3"
                Name="btn9"
                Click="btn9_Click"
                Content="9"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="4" Grid.Column="4"
                Name="btn11"
                Click="btn11_Click"
                Content="+"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <!--BUTTONS 0 C - -->
        <Button Grid.Row="5" Grid.Column="3"
                Name="btn14"
                Click="btn14_Click"
                Content="C"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                Name="btn10"
                Click="btn10_Click"
                Content="0"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="5" Grid.Column="4"
                Name="btn12"
                Click="btn12_Click"
                Content="-"
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <!--BUTTONS OK = -->
        <Button Grid.Row="6" Grid.Column="1"
                Grid.ColumnSpan="3"
                Click="btn_Return"
                Content="OK"
                FontSize="25"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        <Button Grid.Row="6" Grid.Column="4"
                Name="btn13"
                Click="btn13_Click"
                Content="="
                Width="60"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
    </Grid>
</Window>
