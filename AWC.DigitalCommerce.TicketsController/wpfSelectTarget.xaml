<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSelectTarget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Background="DarkBlue" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Height="230" Width="460">
    <Window.Resources>
        <DataTemplate x:Key="cBox_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                   Name="Action"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="MOVER CUENTA A:"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                      Name="cbox_CustomerID"
                      VerticalAlignment="Center"
                      FontSize="30"
                      Margin="5"
                      FontWeight="DemiBold"
                      ItemTemplate="{StaticResource cBox_DataTemplate}"
                      SelectionChanged="cbox_CustomerID_SelectionChanged"/>
            <Button Grid.Row="3" Grid.Column="1"
                    Click="btn_Cancel"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png" Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="3" Grid.Column="3"
                    Name="btnOK"
                    Click="btn_OK"
                    FontSize="20"
                    Margin="5"
                    IsEnabled="False"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/shiftchange.png" Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="ACEPTAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
