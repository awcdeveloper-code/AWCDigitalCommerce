<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="130" Width="450" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border BorderBrush="Fuchsia" BorderThickness="3" Background="White" CornerRadius="10" Padding="10">
        <StackPanel Orientation="Vertical">
            <Image Width="50" Height="50"
                   HorizontalAlignment="Stretch"
                   Source="/Images/G3_Logo.ico" />
            <TextBlock Name="BusinessName"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="DemiBold"/>
            <TextBlock Name="ToastMessage"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="DemiBold"/>
        </StackPanel>
    </Border>
</Window>
