<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfNumericKeyboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="600" Width="400" Background="Cyan"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <!--TEXTBOX-->
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                 Name="txtNum"
                 PreviewTextInput="NumberValidationTextBox"
                 KeyUp="txtNum_KeyUp"
                 Background="LightCyan"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Center"
                 FontSize="50"
                 Margin="5"
                 Padding="5"
                 FontWeight="DemiBold"/>
            <!--BUTTONS 7 8 9-->
            <Button Grid.Row="2" Grid.Column="1"
                Content="7"
                Click="btn_Num7"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="2" Grid.Column="2"
                Content="8"
                Click="btn_Num8"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="2" Grid.Column="3"
                Content="9"
                Click="btn_Num9"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <!--BUTTONS 4 5 6-->
            <Button Grid.Row="3" Grid.Column="1"
                Content="4"
                Click="btn_Num4"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="3" Grid.Column="2"
                Content="5"
                Click="btn_Num5"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="3" Grid.Column="3"
                Content="6"
                Click="btn_Num6"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <!--BUTTONS 1 2 3-->
            <Button Grid.Row="4" Grid.Column="1"
                Content="1"
                Click="btn_Num1"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="4" Grid.Column="2"
                Content="2"
                Click="btn_Num2"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="4" Grid.Column="3"
                Content="3"
                Click="btn_Num3"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <!--BUTTONS CLEAR 0 CLOSE-->
            <Button Grid.Row="5" Grid.Column="1"
                Content="BORRAR"
                Click="btn_Clean"
                Width="100"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="5" Grid.Column="2"
                Content="0"
                Click="btn_Num0"
                Width="100"
                FontSize="40"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
            <Button Grid.Row="5" Grid.Column="3"
                Content="OK"
                Click="btn_OK"
                Width="100"
                FontSize="30"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold" />
        </Grid>
    </Border>
</Window>
