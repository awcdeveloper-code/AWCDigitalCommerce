<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfNewTicketStep1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="570" Width="930" Background="White"
        WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="lBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="25"
                           Foreground="Black"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="lBox_TablesSeats_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="25"
                           Foreground="Black"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="_ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="_Border"
                                Padding="2"
                                SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="_Border" Property="Background" Value="Red"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="White" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="400"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="1"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Content="SELECCIONE A SU CLIENTE"
                   FontSize="30"
                   FontWeight="DemiBold"/>
            <!-- VIP  -->
            <GroupBox Grid.Row="3" Grid.Column="1"
                      Name="VIPGroupBox"
                      Foreground="DarkBlue"
                      Header="CLIENTES FRECUENTES"
                      FontSize="20"
                      FontWeight="DemiBold">
                <StackPanel Orientation="Vertical">
                    <TextBox Name="txtSearchVIP"
                             Background="Cyan"
                             BorderBrush="DarkBlue"
                             Width="290"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="0,5,0,5"
                             FontSize="20"
                             FontWeight="DemiBold"
                             TextChanged="txtSearchVIP_TextChanged"
                             GotFocus="txtSearchVIP_GotFocus" />
                    <ListBox Name="lBox_VIP"
                             Background="Cyan"
                             Height="325"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ItemTemplate="{StaticResource lBox_VIP_DataTemplate}"
                             ItemContainerStyle="{DynamicResource _ListBoxItemStyle}"
                             SelectionChanged="lBox_VIP_SelectionChanged">
                    </ListBox>
                </StackPanel>
            </GroupBox>
            <!-- Tables and Seats  -->
            <GroupBox Grid.Row="3" Grid.Column="3"
                      Name="TablesSeatsGroupBox"
                      Foreground="DarkBlue"
                      Header="MESAS Y BARRAS"
                      FontSize="20"
                      FontWeight="DemiBold">
                <ListBox Name="lBox_TablesSeats"
                         Background="LIME"
                         ItemsSource="{Binding Tables[0]}"
                         ItemTemplate="{StaticResource lBox_TablesSeats_DataTemplate}"
                         ItemContainerStyle="{DynamicResource _ListBoxItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         FontSize="20"
                         SelectionChanged="lBox_TablesSeats_SelectionChanged" />
            </GroupBox>
            <!-- New Table/Seat  -->
            <GroupBox Grid.Row="3" Grid.Column="5"
                      Name="NewTableGroupBox"
                      Foreground="DarkBlue"
                      Header="AGREGAR"
                      FontSize="20"
                      FontWeight="DemiBold">
                <StackPanel Orientation="Vertical">
                    <Label Foreground="DarkBlue"
                           VerticalAlignment="Center"
                           Content="MESA/BARRA TEMPORAL:"
                           Margin="5,5,5,0"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <TextBox Name="txtNewTableSeat"
                             Background="Cyan"
                             BorderBrush="DarkBlue"
                             Height="30"
                             Margin="5,0,5,0"
                             FontSize="20"
                             FontWeight="DemiBold"
                             GotFocus="txtNewTableSeat_GotFocus"
                             KeyUp="txtNewTableSeat_KeyUp"/>
                    <Label Foreground="DarkBlue"
                           VerticalAlignment="Center"
                           Content="CLIENTE NUEVO:"
                           Margin="5,5,5,0"
                           FontSize="15"
                           FontWeight="DemiBold"/>
                    <TextBox Name="txtUnkowCust"
                             Background="Cyan"
                             BorderBrush="DarkBlue"
                             Height="30"
                             Margin="5,0,5,0"
                             FontSize="20"
                             FontWeight="DemiBold"
                             GotFocus="txtUnkowCust_GotFocus"
                             KeyUp="txtUnkowCust_KeyUp"/>
                    <CheckBox Name="ApplyServiceFee"
                              VerticalAlignment="Top"
                              Foreground="DarkBlue"
                              IsChecked="True"
                              Margin="5"
                              FontSize="15"
                              FontWeight="DemiBold"
                              Content=" APLICAR 10% DE SERVICIO"/>
                </StackPanel>
            </GroupBox>
            <Button Grid.Row="5" Grid.Column="1"
                     Name="Close"
                     Click="btn_Close"
                     FontSize="20"
                     Cursor="Hand"
                     FontWeight="DemiBold"
                     Content="CERRAR"/>
            <Button Grid.Row="5" Grid.Column="3"
                     Name="Cancel"
                     Click="btn_Cancel"
                     FontSize="20"
                     Cursor="Hand"
                     FontWeight="DemiBold"
                     Content="CANCELAR"/>
            <Button Grid.Row="5" Grid.Column="5"
                     Name="CustomerSelected"
                     Click="btn_CustomerSelected"
                     IsEnabled="False"
                     FontSize="20"
                     Cursor="Hand"
                     FontWeight="DemiBold"
                     Content="ASIGNAR SELECCION"/>
        </Grid>
    </Border>
</Window>
