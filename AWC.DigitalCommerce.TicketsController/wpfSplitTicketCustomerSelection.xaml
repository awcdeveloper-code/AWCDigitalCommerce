<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSplitTicketCustomerSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="640" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="DarkBlue">
    <Window.Resources>
        <DataTemplate x:Key="lBox_Customer_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="25"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="450"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Content="SELECCIONE EL CLIENTE"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <TextBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
                     Name="txtSearchCustomer"
                     Background="Cyan"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Width="470"
                     FontSize="35"
                     FontWeight="DemiBold"
                     TextChanged="txtSearchCustomer_TextChanged" />
            <ListBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                     Name="lBox_Customer"
                     Height="440"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ItemTemplate="{StaticResource lBox_Customer_DataTemplate}"
                     SelectionChanged="lBox_Customer_SelectionChanged">
            </ListBox>
            <Button Grid.Row="4" Grid.Column="1"
                    Click="btn_Cancel"
                    Foreground="DarkBlue"
                    FontSize="25"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CANCELAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="2"
                    Name="btnOK"
                    Click="btn_OK"
                    Foreground="DarkBlue"
                    FontSize="25"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="ACEPTAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
