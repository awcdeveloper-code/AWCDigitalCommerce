<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfAWCSplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="White" Height="270" Width="690">
    <Border BorderBrush="Cyan" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Image Grid.Column="1" Grid.Row="1" Source="/Images/front_g3.png" />
            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                <Label FontSize="30" FontWeight="Bold"
                   Content="AIDAware Guillermo E. Grillo III"/>
                <Label FontSize="20" FontWeight="DemiBold"
                   Content="Tickets Controller Intellectual Property Owner"/>
                <Label FontSize="20" FontWeight="DemiBold"
                   Content="+506 8820-1824"/>
                <Label FontSize="20" FontWeight="DemiBold"
                   Content="guillermoegrillo@outlook.com"/>
                <Label FontSize="20" FontWeight="DemiBold"
                   Content="San José, Costa Rica"/>
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="1"
                Click="btn_Print"
                FontSize="20"
                Margin="2"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/printer_icon.png"
                           Width="20" Height="20" Margin="5"/>
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="3"
                Click="btn_OK"
                FontSize="20"
                Margin="2"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="20" Height="20" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
