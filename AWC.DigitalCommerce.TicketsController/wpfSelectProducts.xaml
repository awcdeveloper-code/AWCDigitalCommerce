<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSelectProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Background="Cyan" Height="710" Width="735"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Orientation="Horizontal"
                        Margin="1">
                <Image Source="{Binding ImagePath}"
                       Width="25" Height="25"
                       Margin="0,0,5,0"/>
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Cyan" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="250"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!--SEARCH PRODUCT-->
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"
                   Content="SELECCIONE EL PRODUCTO"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                     Name="txtSearchProduct"
                     Background="White"
                     BorderBrush="DarkBlue"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     FontSize="30"
                     FontWeight="DemiBold"
                     TextChanged="txtSearchProduct_TextChanged"
                     GotFocus="txtSearchProduct_GotFocus" />
            <ListBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5"
                     Name="lBox_Products"
                     Background="White"
                     BorderBrush="DarkBlue"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     FontSize="30"
                     ItemTemplate="{StaticResource Items_DataTemplate}"
                     SelectionMode="Single"
                     SelectionChanged="lBox_Products_SelectionChanged">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="40"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Resources>
            </ListBox>
            <!--~SET QUANTITY-->
            <Label Grid.Row="5" Grid.Column="2"
                   Foreground="DarkBlue"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"
                   Content="CANT:"/>
            <TextBox Grid.Row="5" Grid.Column="3"
                     Name="txtQty"
                     IsEnabled="False"
                     Background="White"
                     BorderBrush="DarkBlue"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Center"
                     VerticalAlignment="Center"
                     PreviewTextInput="NumberValidationTextBox"
                     FontSize="30"
                     FontWeight="DemiBold"
                     GotFocus="txtQty_GotFocus" />
            <Image Grid.Row="5" Grid.Column="4"
                   Name="AddProduct"
                   Source="/Images/Plus_sign.png"
                   Width="45" Height="45"
                   IsEnabled="False"
                   Cursor="Hand"
                   MouseDown="btn_AddProduct"/>
            <!--DATAGRID-->
            <DataGrid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="6"
                  Name="ProductsSelected"
                  Height="200" Width="710"
                  RowHeight="35"
                  FontSize="25"
                  FontWeight="DemiBold"
                  HorizontalAlignment="Left"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalAlignment="Top"
                  VerticalContentAlignment="Center"
                  VerticalScrollBarVisibility="Visible"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="LightGray"
                  RowBackground="LightCyan"
                  AlternatingRowBackground="Cyan"
                  BorderBrush="DarkBlue"
                  AreRowDetailsFrozen="True"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False"
                  SelectionChanged="ProductsSelected_SelectionChanged">
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar">
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="40"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CANT"
                                        Width="75"
                                        Binding="{Binding Path=Qty}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="535"
                                        Binding="{Binding Path=ItemDesc}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <!--BUTTONS-->
            <Button Grid.Row="9" Grid.Column="1"
                    Click="btn_Cancel"
                    Background="DarkBlue"
                    FontSize="20"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png" Width="30" Height="30" Margin="5 5 5 0"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="9" Grid.Column="3"
                    Name="btnDelete"
                    Click="btn_Delete"
                    IsEnabled="False"
                    Background="DarkBlue"
                    FontSize="20"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/disabled_sign.png" Width="30" Height="30" Margin="5 5 5 0"/>
                    <TextBlock Text="BORRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="9" Grid.Column="5"
                    Name="btnOK"
                    Click="btn_OK"
                    IsEnabled="False"
                    Background="DarkBlue"
                    FontSize="20"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico" Width="30" Height="30" Margin="5 5 5 0"/>
                    <TextBlock Text="ACEPTAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
