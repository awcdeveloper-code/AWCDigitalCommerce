<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfFingerprintScanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d"
        Title="Fingerprint Scanner" Height="450" Width="400">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="btnStartCapture"
                    Click="btnStartCapture_Click"
                    Content="Start Capture"
                    Width="200" Height="40"
                    Margin="10"/>
            <Button Name="btnStopCapture"
                    Click="btnStopCapture_Click"
                    Content="Stop Capture"
                    Width="200" Height="40"
                    Margin="10"
                    IsEnabled="False"/>
            <Image Name="imgFingerprint"
                   Width="150" Height="200"
                   Margin="10"/>
            <TextBlock Name="txtStatus"
                       Text="Status: Waiting..."
                       FontSize="14"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
