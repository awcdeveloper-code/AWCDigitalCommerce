<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfQryTicketsByCustomerID"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" ResizeMode="NoResize"  Height="550" Width="560"
        WindowStartupLocation="CenterScreen" Background="Orange"
        Title="CUENTAS POR CLIENTE">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="cBox_VIP_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkRed"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="1"
               VerticalAlignment="Center"
               Content="CLIENTE:"
               FontSize="20"
               FontWeight="DemiBold"/>
        <ComboBox Grid.Row="1" Grid.Column="2"
                  Name="cbox_CustomerID"
                  VerticalAlignment="Center"
                  FontSize="20"
                  FontWeight="DemiBold"
                  ItemsSource="{Binding Tables[0]}"
                  ItemTemplate="{StaticResource cBox_VIP_DataTemplate}"
                  SelectionChanged="cbox_CustomerID_SelectionChanged"/>
        <DataGrid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                  Name="TicketsList"
                  Height="400" Width="420"
                  Margin="0,10,0,10"
                  RowHeight="30"
                  FontSize="20"
                  FontWeight="DemiBold"
                  IsReadOnly="True"
                  HorizontalAlignment="Center"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Visible" 
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  Background="LightGray"
                  RowBackground="LightYellow"
                  AlternatingRowBackground="LightBlue"
                  BorderBrush="Gray" BorderThickness="2"
                  AreRowDetailsFrozen="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserSortColumns = "False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA"
                                        Width="120"
                                        Binding="{Binding Path=TicketDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="CUENTA"
                                        Width="120"
                                        Binding="{Binding Path=ID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TOTAL"
                                        Width="150"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
