<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfItemsPriceList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="580" Width="550" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Window.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="Azure" Offset="0.0"/>
            <!-- Cyan -->
            <GradientStop Color="DarkBlue" Offset="1.0"/>
            <!-- Dark Blue -->
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="40"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="Cyan" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="500"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                      Name="GroupBoxDataGrid"
                      Foreground="DarkBlue"
                      FontSize="15"
                      FontWeight="DemiBold"
                      Header="TIPOS: (1) CERVEZAS/LIGAS (2) LICORES (3) COMIDAS">
                <DataGrid Name="ItemsPriceList"
                      Height="460" Width="465"
                      Margin="5"
                      RowHeight="25"
                      IsReadOnly="True"
                      HorizontalAlignment="Left"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible" 
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="Gray" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                        Width="50"
                                        Binding="{Binding Path=ID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TIPO"
                                        Width="50"
                                        Binding="{Binding Path=ItemType}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="215"
                                        Binding="{Binding Path=ItemDescription}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRECIO"
                                        Width="100"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <Button Grid.Row="2" Grid.Column="1"
                Click="btn_Close"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="3"
                Name="PrintItemsList"
                Click="btn_PrintItemsPriceList"
                FontSize="20"
                Margin="5"
                Cursor="Hand"
                IsEnabled="False"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/printer_icon.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
