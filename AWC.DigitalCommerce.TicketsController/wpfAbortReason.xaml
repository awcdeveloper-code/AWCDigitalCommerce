<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfAbortReason"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="280" Width="620" Background="DarkBlue" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                   Name="MealDesc"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Content="RAZÓN DE LA ANULACIÓN"
                   FontSize="30"
                   FontWeight="DemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                     Name="txtAbortReason"
                     FontSize="20"
                     MaxLength="255"
                     TextWrapping="Wrap"
                     HorizontalContentAlignment="Left"
                     FontWeight="DemiBold"
                     KeyUp="AbortReason_KeyUp"/>
            <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                   Foreground="Cyan"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Content="RAZÓN DEBE DE TENER AL MENOS 15 CARACTERES"
                   FontSize="15"
                   FontWeight="DemiBold"/>
            <Button Grid.Row="4" Grid.Column="1"
                Click="btn_Cancel"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png" Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="3"
                Name="btnOK"
                Click="btn_OK"
                IsEnabled="False"
                FontSize="15"
                Margin="5"
                Cursor="Hand"
                FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/Minus_sign.png" Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="ANULAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
