<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfRenameCustomerAKA"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="230" Width="810" Background="Cyan" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Border BorderBrush="Blue" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1"
                   Foreground="DarkBlue"
                   Content="NOMBRE ACTUAL:"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                   Name="lblCustomerAKA"
                   Foreground="DarkBlue"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="2" Grid.Column="1"
                   Foreground="DarkBlue"
                   Content="RENOMBRAR COMO:"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                     Name="txtNewCustomerAKA"
                     BorderBrush="DarkBlue"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     FontSize="25"
                     FontWeight="DemiBold" TextChanged="txtNewCustomerAKA_TextChanged" />
            <Button Grid.Row="4" Grid.Column="1"
                    Click="btn_Cancel"
                    Cursor="Hand"
                    FontSize="20"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CANCELAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="3"
                    Name="btnOK"
                    Click="btn_OK"
                    Cursor="Hand"
                    FontSize="20"
                    FontWeight="DemiBold"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="RENOMBRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>

</Window>
