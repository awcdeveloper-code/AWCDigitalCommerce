<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="260" Width="500"
        ContentRendered="Window_ContentRendered"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent">
    <Grid Margin="10" Background="White">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="15"
                              Direction="-90"
                              RenderingBias="Quality"
                              ShadowDepth="3"/>
        </Grid.Effect>
        <Border BorderBrush="Fuchsia" BorderThickness="5"/>
        <StackPanel Orientation="Vertical">
            <Label Grid.Row="0"
                   Name="lblProcessing"
                   Content="Procesando..."
                   Margin="5" 
                   FontSize="30"
                   FontWeight="DemiBold"
                   FontStretch="Expanded"
                   HorizontalAlignment="Center"/>
            <ProgressBar Grid.Row="1" Height="30"
                         Margin="10" 
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="True"
                         Foreground="DarkBlue" />
            <Image Width="200"
                   Margin="10"
                   Source="/Images/front_g3.png" />
        </StackPanel>
    </Grid>
</Window>
