<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSplitTicket2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="780" Width="955" Background="DarkBlue"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="40"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="lBox_Customer_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Fuchsia" BorderThickness="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Content="CUENTA ACTUAL:"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                   Name="lblTicketNumber"
                   Content="000000"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   FontSize="30"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                   Content="PRODUCTOS A SEPARAR"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <!--SOURCE DATAGRID-->
            <DataGrid Grid.Row="2" Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Grid.RowSpan="12"
                      Name="TicketDetailSource"
                      Height="590" Width="415"
                      RowHeight="30"
                      FontSize="20"
                      FontWeight="DemiBold"
                      Margin="5"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Hidden"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="DarkBlue" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      FrozenColumnCount="2"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False"
                      SelectionChanged="TicketDetailSource_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="285"
                                        Binding="{Binding Path=ItemDesc}"/>
                    <DataGridTextColumn Header="PRECIO"
                                        Width="80"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!--TARGET DATAGRID-->
            <DataGrid Grid.Row="2" Grid.Column="4"
                      Grid.ColumnSpan="2"
                      Grid.RowSpan="8"
                      Name="TicketDetailTarget"
                      Height="390" Width="415"
                      RowHeight="30"
                      FontSize="20"
                      FontWeight="DemiBold"
                      Margin="5"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Hidden"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="DarkBlue" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      FrozenColumnCount="2"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False"
                      SelectionChanged="TicketDetailTarget_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Width="285"
                                        Binding="{Binding Path=ItemDesc}"/>
                    <DataGridTextColumn Header="PRECIO"
                                        Width="80"
                                        Binding="{Binding Path=UnitPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Label Grid.Row="10" Grid.Column="4"
                   Content="SUB-TOTAL :"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="10" Grid.Column="5"
                   Name="lblSubTotalPrice"
                   Content="0"
                   Margin="5"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="11" Grid.Column="4"
                   Content="10% SERVICIO :"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="11" Grid.Column="5"
                   Name="lblServiceFee"
                   Content="0"
                   Margin="5"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="12" Grid.Column="4"
                   Content="13% IVA :"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="12" Grid.Column="5"
                   Name="lblIVAFee"
                   Content="0"
                   Margin="5"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="13" Grid.Column="4"
                   Content="TOTAL :"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <Label Grid.Row="13" Grid.Column="5"
                   Name="lblTotalPrice"
                   Content="0"
                   Margin="5"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <!--BUTTONS-->
            <Button Grid.Row="14" Grid.Column="1"
                    Name="Close"
                    Click="btn_Close"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png" Width="20" Height="20" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="14" Grid.Column="2"
                    Name="Cancel"
                    Click="btn_Cancel"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/clean.png" Width="20" Height="20" Margin="5"/>
                    <TextBlock Text="CANCELAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Image Grid.Row="5" Grid.Column="3"
                   Name="AddOne2Right"
                   Source="/Images/circled-right.png"
                   ToolTip="Asignar el item seleccionado."
                   Cursor="Hand"
                   Visibility="Visible"
                   MouseDown="btn_Add2Right"/>
            <Image Grid.Row="6" Grid.Column="3"
                   Name="AddOne2Left"
                   Source="/Images/circled-left.png"
                   ToolTip="Devolver el item seleccionado."
                   Cursor="Hand"
                   Visibility="Visible"
                   MouseDown="btn_Add2Left"/>
            <CheckBox Grid.Row="15" Grid.Column="1"
                  Name="PrintClosedTicket"
                  Click="chkBox_PrintClosedTicket"
                      Foreground="Cyan"
                  VerticalAlignment="Center"
                  IsChecked="False"
                  Margin="5"
                  FontSize="15"
                  FontWeight="DemiBold"
                  Content="IMPRIMIR CANCELADA"/>
            <Button Grid.Row="14" Grid.Column="4"
                    Name="Print"
                    Click="btn_Print"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/printer_icon.png" Width="20" Height="20" Margin="5"/>
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="14" Grid.Column="5"
                    Name="NewTicket"
                    Click="btn_NewTicket"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/parent.ico" Width="25" Height="25" Margin="5 5 5 0"/>
                    <TextBlock Text="ABRIR CUENTA" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="15" Grid.Column="4"
                    Name="Proforms"
                    Click="btn_Proforms"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/storage.png" Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="PREFACTURAS" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="15" Grid.Column="5"
                    Name="Pay"
                    Click="btn_Pay"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/money_icon.png" Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="PAGAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
