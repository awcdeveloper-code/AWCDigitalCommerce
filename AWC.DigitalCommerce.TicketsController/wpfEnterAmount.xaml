<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfEnterAmount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="230" Width="350" Background="Cyan" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen" WindowState="Normal">
    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition />
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1"
                   Name="MealDesc"
                   Foreground="DarkBlue"
                   VerticalAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Content="INGRESE EL MONTO"
                   FontSize="30"
                   FontWeight="DemiBold"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Name="txtAmount"
                     FontSize="30"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Left"
                     FontWeight="DemiBold"
                     KeyUp="txtAmount_KeyUp"/>
            <Button Grid.Row="3" Grid.Column="1"
                    Click="btn_OK"
                    FontSize="15"
                    Width="100"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/next.png"
                           Width="30" Height="30" Margin="5"/>
                    <TextBlock Text="OK" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
