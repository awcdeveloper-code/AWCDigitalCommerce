<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfWorkLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Title="AWC Digital Commerce" Height="700" Width="1024">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="710"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <!--LEFT PANEL-->
        <GroupBox Grid.Row="1" Grid.Column="1"
                  Header="Bitácoras Disponibles"
                  FontSize="20"
                  FontWeight="DemiBold">
            <!--TREEVIEW-->
            <TreeView Name="LogTreeView"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="5"
                      FontSize="15"
                      FontWeight="DemiBold"
                      Width="260"
                      Height="590"
                      MouseDoubleClick="LogTreeView_MouseDoubleClick">
            </TreeView>
        </GroupBox>
        <!--CENTRAL PANEL-->
        <GroupBox Grid.Row="1" Grid.Column="3"
                  Header="Contenido de la bitacora activa">
            <ListBox Name="LogContent"
                     FontFamily="Arial"
                     FontSize="12"
                     Margin="5"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Width="680"
                     Height="610">
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
