<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfTicketsLost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Height="500" Width="719" Background="Cyan"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="lBox_Customer_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="25"
                           Foreground="DarkBlue"
                           Text="{Binding CustomerID}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Items_DataTemplate">
            <StackPanel Margin="1">
                <TextBlock FontWeight="DemiBold"
                           FontSize="20"
                           Foreground="DarkBlue"
                           Text="{Binding ItemDescription}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="Blue" BorderThickness="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                   Name="lblHeader"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="DarkBlue"
                   FontSize="25"
                   FontWeight="DemiBold"/>
            <DataGrid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                      Name="TicketsLost"
                      Height="365"
                      FontSize="20"
                      FontWeight="DemiBold"
                      HorizontalAlignment="Left"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalAlignment="Top"
                      VerticalContentAlignment="Center"
                      VerticalScrollBarVisibility="Visible"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="LightGray"
                      RowBackground="LightCyan"
                      AlternatingRowBackground="Cyan"
                      BorderBrush="DarkBlue" BorderThickness="2"
                      AreRowDetailsFrozen="True"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns = "False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA"
                                        Width="100"
                                        Binding="{Binding Path=TicketDate}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ID"
                                        Width="65"
                                        Binding="{Binding Path=ID}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CLIENTE"
                                        Width="415"
                                        Binding="{Binding Path=CustomerAKA}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}"/>
                    <DataGridTextColumn Header="TOTAL"
                                        Width="88"
                                        Binding="{Binding Path=TotalPrice, StringFormat=N0}"
                                        HeaderStyle="{StaticResource CenterGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="3" Grid.Column="1"
                    Click="btn_Cancel"
                    FontSize="15"
                    Margin="3"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="3" Grid.Column="2"
                    Click="btn_Print"
                    FontSize="15"
                    Margin="3"
                    Cursor="Hand"
                    IsEnabled="False"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/printer_icon.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Label Grid.Row="3" Grid.Column="3"
                   Name="lblTotalAmount"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="DarkBlue"
                   FontSize="25"
                   FontWeight="DemiBold"/>
        </Grid>
    </Border>
</Window>
