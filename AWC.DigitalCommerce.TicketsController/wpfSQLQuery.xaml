<Window x:Class="AWC.DigitalCommerce.TicketsController.wpfSQLQuery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AWC.DigitalCommerce.TicketsController"
        mc:Ignorable="d" Background="DarkBlue" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Title="wpfSQLQuery" Height="600" Width="1000" ResizeMode="NoResize">
    <Border BorderBrush="Fuchsia" BorderThickness="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                   Foreground="Cyan"
                   VerticalAlignment="Center"
                   FontSize="15"
                   FontWeight="DemiBold"
                   Content="ESCRIBA EL COMANDO QUE DESEA EJECUTAR (T-SQL):"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                     Name="txtBoxSQLCmd"
                     Background="LightCyan"
                     Margin="5"
                     FontSize="20"
                     FontWeight="DemiBold"
                     TextWrapping="Wrap"/>
            <DataGrid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                      Name="dgvSQLQueryTab"
                      RowHeight="30"
                      FontSize="20"
                      Margin="5"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      Background="white"
                      RowBackground="Cyan"
                      AlternatingRowBackground="LightCyan"
                      AutoGenerateColumns="True"
                      BorderBrush="DarkBlue"
                      SelectionMode="Single" />
            <Button Grid.Row="4" Grid.Column="1"
                    Click="btn_Close"
                    FontSize="15"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/delete_sign.png"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CERRAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="2"
                    Click="btn_Clean"
                    FontSize="15"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/14.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="CANCELAR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Row="4" Grid.Column="4"
                    Click="btn_Execute"
                    FontSize="20"
                    Margin="5"
                    Cursor="Hand"
                    FontWeight="DemiBold">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/38.ico"
                           Width="25" Height="25" Margin="5"/>
                    <TextBlock Text="OK" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
