<Window x:Class="AWC.DigitalCommerce.POSitive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AWC POSitive 2025" Height="733" Width="1200"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent">
    <Grid MouseDown="Grid_MouseDown">
        <Border Background="DarkSlateBlue" CornerRadius="0,0,10,10" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="AWC POSitive 2025"
                           Foreground="Cyan"
                           FontSize="15"
                           FontWeight="DemiBold"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
                <Button Content="X" Width="30" Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Click="CloseButton_Click"/>
                <Border Grid.Row="1" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <!--TABCONTROL-->
                        <TabControl Grid.ColumnSpan="2"
                                    Name="tabCtrlWorkArea"
                                    Visibility="Visible"
                                    Margin="5"
                                    Background="Transparent">
                        </TabControl>
                        <!--OPTIONS-->
                        <StackPanel Grid.Column="1"
                                    Name="OptionsStack"
                                    Orientation="Vertical"
                                    Background="DarkSlateBlue"
                                    Visibility="Visible">
                            <Button Name="Option1" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/quickSale.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="VENTA RÁPIDA"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option2" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/accounts.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="CUENTAS"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option3" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/a2p2.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="PENDIENTES"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option4" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/todaysales.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="VENTAS"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option5" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/search.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="CONSULTAS"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option6" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/report.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="CIERRE DIARIO"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option7" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/inventory.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="INVENTARIO"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option8" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/settings.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="AJUSTES"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Optio9" Height="60"
                                    Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/cashier.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="ABRIR CAJA"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Name="Option10" Height="60"
                                    Margin="5" Click="Option10_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/logout.png"
                                        Width="35" Height="35" Margin="5"/>
                                    <TextBlock Text="SALIR"
                                               FontSize="15"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
