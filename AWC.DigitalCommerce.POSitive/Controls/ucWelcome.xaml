<UserControl x:Class="AWC.DigitalCommerce.POSitive.Controls.ucWelcome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AWC.DigitalCommerce.POSitive.Controls"
             mc:Ignorable="d" Background="Transparent"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text= "AWC POSitive 2025"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="DarkSlateBlue"
                   FontFamily="Bahnschrift SemiLight Condensed"
                   FontSize="130"
                   FontWeight="Bold"/>
            <ProgressBar Name="IsProgressBarIndeterminate"
                     Width="1000"
                     Height="5"
                     BorderBrush="Transparent"
                     Background="Transparent"
                     Foreground="Cyan"
                     IsIndeterminate="True"/>
            <TextBlock Name="CurrentDateTime"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="DarkSlateBlue"
                       FontFamily="Bahnschrift SemiLight Condensed"
                       FontSize="130"
                       FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
